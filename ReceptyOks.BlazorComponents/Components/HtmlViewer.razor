@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<MudPaper Class="html-viewer-container" Style="@AdditionalStyle" Elevation="@Elevation">
    @if (string.IsNullOrEmpty(HtmlContent))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="empty-placeholder">
            Brak zawartoœci
        </MudText>
    }
    else
    {
        <div class="html-viewer-content">
                 @((MarkupString)HtmlContent)
        </div>
    }
</MudPaper>

@code {
    /// <summary>
    /// HTML content to display (e.g., recipe instructions)
    /// </summary>
    [Parameter]
    public string HtmlContent { get; set; } = string.Empty;

    /// <summary>
    /// Optional additional inline style to apply on the root container (e.g. custom background/color)
    /// </summary>
    [Parameter]
    public string AdditionalStyle { get; set; } = string.Empty;

    /// <summary>
    /// Paper elevation (shadow depth). Default is 0 for flat appearance.
    /// </summary>
    [Parameter]
    public int Elevation { get; set; } = 0;
}
