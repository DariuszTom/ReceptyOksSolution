@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using ReceptyOks.BlazorComponents.Services
@using Ganss.Xss
@inject HtmlViewerState ViewerState
@implements IDisposable

<div class="html-viewer-container @ThemeClass" style="@ContainerStyle">
    @if (string.IsNullOrEmpty(_displayContent))
    {
        <span class="empty-placeholder">Brak zawartości</span>
    }
    else
    {
        <div class="html-viewer-content">
            @((MarkupString)_displayContent)
        </div>
    }
</div>

@code {
    private readonly HtmlSanitizer _htmlSanitizer = new();
    private string _displayContent = string.Empty;

    /// <summary>
    /// HTML content to display (e.g., recipe instructions).
    /// Can be set via parameter or via HtmlViewerState service.
    /// </summary>
    [Parameter]
    public string HtmlContent { get; set; } = string.Empty;

    /// <summary>
    /// Optional additional inline style to apply on the root container (e.g. custom background/color)
    /// </summary>
    [Parameter]
    public string AdditionalStyle { get; set; } = string.Empty;

    /// <summary>
  /// Maximum height of the container. When content exceeds this, a scrollbar appears.
    /// Use CSS units (e.g., "400px", "50vh"). Empty string means no max height.
    /// </summary>
    [Parameter]
    public string MaxHeight { get; set; } = string.Empty;

    /// <summary>
    /// Whether to show scrollbar when content overflows. Default is true.
    /// </summary>
    [Parameter]
    public bool EnableScroll { get; set; } = true;

    /// <summary>
    /// Whether to use dark theme styling. When true, applies dark theme colors.
    /// </summary>
    [Parameter]
    public bool IsDarkTheme { get; set; }

/// <summary>
    /// Padding for the content area (e.g., "8px", "1rem"). Default is "8px".
    /// </summary>
    [Parameter]
    public string Padding { get; set; } = "8px";

    private string ThemeClass => IsDarkTheme ? "theme-dark" : "theme-light";

    private string ContainerStyle => BuildContainerStyle();

    protected override void OnInitialized()
    {
        // Subscribe to external content changes pushed from MAUI side
        ViewerState.ContentChanged += OnExternalContentChanged;

        // Initialize display content from parameter if provided
        if (!string.IsNullOrEmpty(HtmlContent))
        {
            _displayContent = SanitizeHtml(HtmlContent);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Signal to MAUI side that Blazor component is ready
            // This will flush any pending content that was set before initialization
            ViewerState.SignalReady();

            // After SignalReady, the state content is authoritative
            var stateContent = ViewerState.Content;
            if (!string.IsNullOrEmpty(stateContent) && _displayContent != stateContent)
            {
                _displayContent = SanitizeHtml(stateContent);
                InvokeAsync(StateHasChanged);
            }
        }
    }

    protected override void OnParametersSet()
    {
        // If HtmlContent parameter is set and state is empty, use parameter
        if (!string.IsNullOrEmpty(HtmlContent) && string.IsNullOrEmpty(ViewerState.Content))
        {
            _displayContent = SanitizeHtml(HtmlContent);
        }
    }

    private void OnExternalContentChanged(object? sender, string newContent)
    {
        _displayContent = SanitizeHtml(newContent);
        InvokeAsync(StateHasChanged);
    }

    private string SanitizeHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
        {
            return string.Empty;
        }

        return _htmlSanitizer.Sanitize(html);
    }

    public void Dispose()
    {
        ViewerState.ContentChanged -= OnExternalContentChanged;
        // Pause delivery — content is preserved for the next component instance
        ViewerState.Pause();
    }

    private string BuildContainerStyle()
    {
        var styles = new List<string>();

        if (!string.IsNullOrEmpty(Padding))
        {
            styles.Add($"padding: {Padding}");
        }

        if (!string.IsNullOrEmpty(MaxHeight))
        {
            styles.Add($"max-height: {MaxHeight}");
        }

        if (EnableScroll)
        {
            styles.Add("overflow-y: auto");
        }

        if (!string.IsNullOrEmpty(AdditionalStyle))
        {
            styles.Add(AdditionalStyle.TrimEnd(';'));
        }

        return string.Join("; ", styles);
    }
}
