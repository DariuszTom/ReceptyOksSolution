@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using ReceptyOks.BlazorComponents.Services
@using Ganss.Xss
@inject HtmlViewerState ViewerState
@implements IDisposable

<div class="html-viewer-container @ThemeClass" style="@ContainerStyle">
    @if (string.IsNullOrEmpty(_displayContent))
    {
        <span class="empty-placeholder">Brak zawartości</span>
    }
    else
    {
        <div class="html-viewer-content">
            @((MarkupString)_displayContent)
        </div>
    }
</div>

@code {
    // Sanitize() is thread-safe once configured.
    private static readonly HtmlSanitizer Sanitizer = CreateSanitizer();

    private static readonly string[] AllowedVideoPrefixes =
    [
        "https://www.youtube.com/embed/",
        "https://youtube.com/embed/",
        "https://www.youtube-nocookie.com/embed/",
        "https://player.vimeo.com/video/"
    ];

    private static HtmlSanitizer CreateSanitizer()
    {
        var sanitizer = new HtmlSanitizer();

        // Quill embeds images as base64 data URIs and videos as <iframe class="ql-video">
        sanitizer.AllowedSchemes.Add("data");
        sanitizer.AllowedTags.Add("iframe");
        sanitizer.AllowedAttributes.Add("allowfullscreen");
        sanitizer.AllowedAttributes.Add("frameborder");
        sanitizer.AllowedAttributes.Add("allow");
        sanitizer.AllowedAttributes.Add("class");

        sanitizer.FilterUrl += (_, e) =>
        {
            var tag = e.Tag?.TagName;
            var url = e.OriginalUrl?.Trim() ?? string.Empty;

            if (string.Equals(tag, "iframe", StringComparison.OrdinalIgnoreCase))
            {
                e.SanitizedUrl = AllowedVideoPrefixes.Any(p => url.StartsWith(p, StringComparison.OrdinalIgnoreCase))
                    ? url
                    : null;
            }
            else if (url.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
            {
                // data: only for raster images inside <img>
                var isImg = string.Equals(tag, "img", StringComparison.OrdinalIgnoreCase);
                var isRaster = url.StartsWith("data:image/png", StringComparison.OrdinalIgnoreCase)
                    || url.StartsWith("data:image/jpeg", StringComparison.OrdinalIgnoreCase)
                    || url.StartsWith("data:image/jpg", StringComparison.OrdinalIgnoreCase)
                    || url.StartsWith("data:image/gif", StringComparison.OrdinalIgnoreCase)
                    || url.StartsWith("data:image/webp", StringComparison.OrdinalIgnoreCase);
                e.SanitizedUrl = isImg && isRaster ? url : null;
            }
        };

        return sanitizer;
    }

    private string _displayContent = string.Empty;

    /// <summary>
    /// HTML content to display (e.g., recipe instructions).
    /// Can be set via parameter or via HtmlViewerState service.
    /// </summary>
    [Parameter]
    public string HtmlContent { get; set; } = string.Empty;

    /// <summary>
    /// Optional additional inline style to apply on the root container (e.g. custom background/color)
    /// </summary>
    [Parameter]
    public string AdditionalStyle { get; set; } = string.Empty;

    /// <summary>
  /// Maximum height of the container. When content exceeds this, a scrollbar appears.
    /// Use CSS units (e.g., "400px", "50vh"). Empty string means no max height.
    /// </summary>
    [Parameter]
    public string MaxHeight { get; set; } = string.Empty;

    /// <summary>
    /// Whether to show scrollbar when content overflows. Default is true.
    /// </summary>
    [Parameter]
    public bool EnableScroll { get; set; } = true;

    /// <summary>
    /// Whether to use dark theme styling. When true, applies dark theme colors.
    /// </summary>
    [Parameter]
    public bool IsDarkTheme { get; set; }

/// <summary>
    /// Padding for the content area (e.g., "8px", "1rem"). Default is "8px".
    /// </summary>
    [Parameter]
    public string Padding { get; set; } = "8px";

    private string ThemeClass => IsDarkTheme ? "theme-dark" : "theme-light";

    private string ContainerStyle => BuildContainerStyle();

    protected override void OnInitialized()
    {
        // Subscribe to external content changes pushed from MAUI side
        ViewerState.ContentChanged += OnExternalContentChanged;

        // Initialize display content from parameter if provided
        if (!string.IsNullOrEmpty(HtmlContent))
        {
            _displayContent = Sanitize(HtmlContent);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Signal to MAUI side that Blazor component is ready
            // This will flush any pending content that was set before initialization
            ViewerState.SignalReady();

            // After SignalReady, the state content is authoritative
            var stateContent = Sanitize(ViewerState.Content);
            if (!string.IsNullOrEmpty(stateContent) && _displayContent != stateContent)
            {
                _displayContent = stateContent;
                InvokeAsync(StateHasChanged);
            }
        }
    }

    protected override void OnParametersSet()
    {
        // If HtmlContent parameter is set and state is empty, use parameter
        if (!string.IsNullOrEmpty(HtmlContent) && string.IsNullOrEmpty(ViewerState.Content))
        {
            _displayContent = Sanitize(HtmlContent);
        }
  }

    private void OnExternalContentChanged(object? sender, string newContent)
    {
        _displayContent = Sanitize(newContent);
        InvokeAsync(StateHasChanged);
    }

    private static string Sanitize(string? html) =>
        string.IsNullOrEmpty(html) ? string.Empty : Sanitizer.Sanitize(html);

    public void Dispose()
    {
        ViewerState.ContentChanged -= OnExternalContentChanged;
        // Pause delivery — content is preserved for the next component instance
        ViewerState.Pause();
    }

    private string BuildContainerStyle()
    {
        var styles = new List<string>();

        if (!string.IsNullOrEmpty(Padding))
        {
            styles.Add($"padding: {Padding}");
        }

        if (!string.IsNullOrEmpty(MaxHeight))
        {
            styles.Add($"max-height: {MaxHeight}");
        }

        if (EnableScroll)
        {
            styles.Add("overflow-y: auto");
        }

        if (!string.IsNullOrEmpty(AdditionalStyle))
        {
            styles.Add(AdditionalStyle.TrimEnd(';'));
        }

        return string.Join("; ", styles);
    }
}
