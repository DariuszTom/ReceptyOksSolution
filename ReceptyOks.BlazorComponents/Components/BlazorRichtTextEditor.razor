@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Spillgebees.Blazor.RichTextEditor.Components
@using Spillgebees.Blazor.RichTextEditor.Components.Toolbar
@using ReceptyOks.BlazorComponents.Services
@inject IJSRuntime JSRuntime
@inject InstructionsEditorState EditorState
@implements IAsyncDisposable

<style>
.blazor-rich-text-editor {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: var(--rte-min-height, 400px);
}

.blazor-rich-text-editor .ql-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    min-height: 0;
}

.blazor-rich-text-editor .ql-editor {
    flex: 1;
    min-height: 0;
}

.blazor-rich-text-editor .ql-toolbar {
    /* keep toolbar visible while the content scrolls */
    position: sticky;
    top: 0;
    z-index: 5;
    flex-shrink: 0;
}

/* Keep a thin separator line under the toolbar (restore Quill default look) */
.blazor-rich-text-editor .ql-toolbar.ql-snow,
.blazor-rich-text-editor .ql-toolbar {
    border-bottom: 1px solid var(--rte-border-color, #e0e0e0) !important;
    box-shadow: none !important;
    background-color: var(--rte-toolbar-bg, transparent) !important;
}

/* Remove the duplicate top border from the content container */
.blazor-rich-text-editor .ql-container.ql-snow,
.blazor-rich-text-editor .ql-container {
    border-top: none !important;
}

/* Light theme (default) */
.blazor-rich-text-editor.theme-light {
    --rte-bg: #ffffff;
    --rte-text: #212121;
    --rte-border-color: #e0e0e0;
    --rte-toolbar-bg: #fafafa;
    --rte-placeholder: #9e9e9e;
}

/* Dark theme */
.blazor-rich-text-editor.theme-dark {
    --rte-bg: #1e1e1e;
    --rte-text: #e0e0e0;
    --rte-border-color: #424242;
    --rte-toolbar-bg: #2d2d2d;
    --rte-placeholder: #757575;
}

.blazor-rich-text-editor.theme-dark .ql-toolbar.ql-snow {
    background-color: var(--rte-toolbar-bg) !important;
    border-color: var(--rte-border-color) !important;
}

.blazor-rich-text-editor.theme-dark .ql-container.ql-snow {
    background-color: var(--rte-bg) !important;
    border-color: var(--rte-border-color) !important;
}

.blazor-rich-text-editor.theme-dark .ql-editor {
    color: var(--rte-text) !important;
}

.blazor-rich-text-editor.theme-dark .ql-editor.ql-blank::before {
    color: var(--rte-placeholder) !important;
}

/* Dark theme toolbar buttons */
.blazor-rich-text-editor.theme-dark .ql-toolbar .ql-stroke {
    stroke: #b0b0b0 !important;
}

.blazor-rich-text-editor.theme-dark .ql-toolbar .ql-fill {
    fill: #b0b0b0 !important;
}

.blazor-rich-text-editor.theme-dark .ql-toolbar .ql-picker {
    color: #b0b0b0 !important;
}

.blazor-rich-text-editor.theme-dark .ql-toolbar .ql-picker-options {
    background-color: var(--rte-toolbar-bg) !important;
    border-color: var(--rte-border-color) !important;
}

.blazor-rich-text-editor.theme-dark .ql-toolbar button:hover .ql-stroke,
.blazor-rich-text-editor.theme-dark .ql-toolbar .ql-picker-label:hover .ql-stroke {
    stroke: #ffffff !important;
}

.blazor-rich-text-editor.theme-dark .ql-toolbar button:hover .ql-fill,
.blazor-rich-text-editor.theme-dark .ql-toolbar .ql-picker-label:hover .ql-fill {
    fill: #ffffff !important;
}

.blazor-rich-text-editor.theme-dark .ql-toolbar button.ql-active .ql-stroke {
    stroke: #90caf9 !important;
}

.blazor-rich-text-editor.theme-dark .ql-toolbar button.ql-active .ql-fill {
    fill: #90caf9 !important;
}

/* WebKit scrollbar styling (Chrome, Edge, Safari) */
.blazor-rich-text-editor .ql-container::-webkit-scrollbar {
    width: 10px;
}
.blazor-rich-text-editor .ql-container::-webkit-scrollbar-track {
    /* Make the track subtly visible so the scrollbar is always noticeable */
    background: rgba(0,0,0,0.06);
}
.blazor-rich-text-editor .ql-container::-webkit-scrollbar-thumb {
    background-color: rgba(100,100,100,0.6);
    border-radius: 8px;
    border: 2px solid transparent;
    background-clip: padding-box;
}
.blazor-rich-text-editor.theme-dark .ql-container::-webkit-scrollbar-thumb {
    background-color: rgba(200,200,200,0.28);
}
</style>

<div class="blazor-rich-text-editor @ThemeClass @CssClass" style="@CombinedStyle">
    <ErrorBoundary @ref="_errorBoundary">
        <ChildContent>
            <RichTextEditor @bind-Content="@Content"
                            @bind-Content:after="OnContentChangedAsync"
                            @bind-Text="@_plainText"
                            Theme="@Theme"
                            ToolbarOptions="@ToolbarOptions"
                            Placeholder="@Placeholder" />
        </ChildContent>
        <ErrorContent Context="exception">
            <div style="padding: 16px; background: #fee; border: 1px solid #c00; color: #c00; border-radius: 8px;">
                <strong>Błąd edytora:</strong>
                <p>@exception.Message</p>
                <details>
                    <summary>Szczegóły</summary>
                    <pre style="font-size: 12px; white-space: pre-wrap;">@exception.ToString()</pre>
                </details>
                <button @onclick="Recover" style="margin-top: 8px;">Spróbuj ponownie</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</div>

@code {
    private string _plainText = string.Empty;
    private ErrorBoundary? _errorBoundary;
    private bool _isInitialized;
    private bool _updatingFromState;

    private string ThemeClass => IsDarkTheme ? "theme-dark" : "theme-light";

    private string CombinedStyle =>
        string.IsNullOrWhiteSpace(Style)
   ? $"--rte-max-height:{MaxHeight};--rte-min-height:{MinHeight};--rte-editor-min-height:{EditorMinHeight};"
     : $"--rte-max-height:{MaxHeight};--rte-min-height:{MinHeight};--rte-editor-min-height:{EditorMinHeight};{Style}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isInitialized = true;

            // Subscribe and signal readiness BEFORE any JS interop —
            // if the JS call fails, content delivery still works.
            EditorState.ContentChanged += OnExternalContentChanged;
            EditorState.SignalReady();

            // Apply theme (non-critical — component works without it)
            try
            {
                await ApplyBodyThemeAsync();
            }
            catch
            {
                // Android WebView may not have JS ready yet; theme is cosmetic
            }

            var stateContent = EditorState.Content;
            if (!string.IsNullOrEmpty(stateContent))
            {
                _updatingFromState = true;
                Content = stateContent;
                await InvokeAsync(() =>
                {
                    _updatingFromState = false;
                    StateHasChanged();
                });
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isInitialized)
        {
            await ApplyBodyThemeAsync();
        }
    }

    private async Task ApplyBodyThemeAsync()
    {
        var themeClass = IsDarkTheme ? "theme-dark" : "theme-light";
        var removeClass = IsDarkTheme ? "theme-light" : "theme-dark";

        await JSRuntime.InvokeVoidAsync("eval", $@"
            document.documentElement.classList.remove('{removeClass}');
            document.documentElement.classList.add('{themeClass}');
            document.body.classList.remove('{removeClass}');
            document.body.classList.add('{themeClass}');
        ");
    }

    public async ValueTask DisposeAsync()
    {
        EditorState.ContentChanged -= OnExternalContentChanged;
        // Pause delivery — content is preserved for the next component instance
        EditorState.Pause();

        // Clean up theme classes when component is disposed
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                document.documentElement.classList.remove('theme-dark', 'theme-light');
                document.body.classList.remove('theme-dark', 'theme-light');
            ");
        }
        catch
        {
            // Ignore errors during disposal (e.g., if JS runtime is unavailable)
        }
    }

    private void OnExternalContentChanged(object? sender, string newContent)
    {
        _updatingFromState = true;
        Content = newContent;
        InvokeAsync(() =>
        {
            StateHasChanged();
            _updatingFromState = false;
        });
    }

    /// <summary>
    /// HTML content of the editor. Supports two-way binding.
    /// </summary>
    [Parameter]
    public string Content { get; set; } = string.Empty;

    /// <summary>
    /// Callback invoked when the content changes.
    /// </summary>
    [Parameter]
    public EventCallback<string> ContentChanged { get; set; }

    /// <summary>
    /// Plain text content (read-only, derived from HTML content).
    /// </summary>
    [Parameter]
    public string PlainText { get; set; } = string.Empty;

    /// <summary>
    /// Callback invoked when the plain text changes.
    /// </summary>
    [Parameter]
    public EventCallback<string> PlainTextChanged { get; set; }

    /// <summary>
    /// Quill theme to use. Defaults to Snow.
    /// </summary>
    [Parameter]
    public QuillTheme Theme { get; set; } = QuillTheme.Snow;

    /// <summary>
    /// Toolbar configuration options. Defaults to full toolbar.
    /// </summary>
    [Parameter]
    public ToolbarOptions ToolbarOptions { get; set; } = ToolbarOptions.FullToolbarOptions with { ShowMathControls = false };

    /// <summary>
    /// Placeholder text shown when editor is empty.
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "Wprowadź tekst...";

    /// <summary>
    /// Additional CSS classes to apply to the container.
    /// </summary>
    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    /// <summary>
    /// Additional inline styles to apply to the container.
    /// </summary>
    [Parameter]
    public string Style { get; set; } = string.Empty;

    /// <summary>
    /// Maximum height for the editor content area (e.g. "400px", "50vh").
    /// When the content grows beyond this height the editor body will scroll
    /// while the toolbar remains visible.
    /// </summary>
    [Parameter]
    public string MaxHeight { get; set; } = "400px";

    /// <summary>
    /// Minimum height for the entire editor component (e.g. "300px", "100%").
    /// Use "100%" to fill available space in parent container.
    /// </summary>
    [Parameter]
    public string MinHeight { get; set; } = "300px";

    /// <summary>
    /// Minimum height for the editor content area (e.g. "250px").
    /// This ensures the editable area has sufficient height for comfortable editing.
    /// </summary>
    [Parameter]
    public string EditorMinHeight { get; set; } = "250px";

    /// <summary>
    /// Whether to use dark theme styling. When true, applies dark theme colors.
    /// </summary>
    [Parameter]
    public bool IsDarkTheme { get; set; }

    private async Task OnContentChangedAsync()
    {
        // Avoid echoing back content that was just set from the MAUI side
        if (_updatingFromState)
        {
            _updatingFromState = false;
            return;
        }

        // Push user edits to the shared state (without re-entering this handler)
        EditorState.ContentChanged -= OnExternalContentChanged;
        EditorState.Content = Content;
        EditorState.ContentChanged += OnExternalContentChanged;

        if (ContentChanged.HasDelegate)
        {
            await ContentChanged.InvokeAsync(Content);
        }

        if (PlainTextChanged.HasDelegate)
        {
            await PlainTextChanged.InvokeAsync(_plainText);
        }
    }
    private void Recover()
    {
        _errorBoundary?.Recover();
    }
}
