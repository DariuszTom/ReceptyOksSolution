    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MVVMTK0042</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".azure\containerapp-template.yaml" />
