<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    <!-- Resizetizer 11 (SkiaSharp 4.x) flows in via ReceptyOks and clashes with SkiaSharp 3.x from Mapsui;
         the test host doesn't need image/font processing. -->
    <PackageReference Include="Microsoft.Maui.Resizetizer" Version="11.0.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeSeeker\HomeSeeker.csproj" />
    <ProjectReference Include="..\ReceptyOks\ReceptyOks.csproj" />
    <ProjectReference Include="..\ReceptyOks.Api\ReceptyOks.Api.csproj" />
    <ProjectReference Include="..\ReceptyOks.Shared\ReceptyOks.Shared.csproj" />
    <ProjectReference Include="..\ReceptyOksSolution.ServiceDefaults\ReceptyOksSolution.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Configuration\" />
  </ItemGroup>

</Project>
