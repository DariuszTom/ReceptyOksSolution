<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReceptyOks.Controls.ChatAIButton"
             BackgroundColor="Transparent"
             MinimumWidthRequest="24" MinimumHeightRequest="24"
             MaximumHeightRequest="24" MaximumWidthRequest="24">
    <Grid HorizontalOptions="Center" VerticalOptions="Center">
        <ImageButton x:Name="PART_ImageButton"
                     Source="chatbot.png"
                     BackgroundColor="Transparent"
                     Aspect="AspectFit"
                     WidthRequest="24"
                     HeightRequest="24"
                     Clicked="OnImageButtonClicked"
                     SemanticProperties.Hint="Open AI chat" />
    </Grid>
</ContentView>
