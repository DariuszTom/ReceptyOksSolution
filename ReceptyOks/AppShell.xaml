<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReceptyOks.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ReceptyOks.Views"
    xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    Title="ReceptyOks"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource Gray400}"
    Shell.NavBarHasShadow="True"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">

    <Shell.Resources>
        <Style x:Key="BaseStyle" TargetType="Element">
            <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}" />
        </Style>
    </Shell.Resources>

    <TabBar>
        <Tab Title="Przepisy">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Restaurant_menu}"
                                 FontFamily="MaterialSymbolsOutlined"
                                 Size="24"/>
            </Tab.Icon>
            <ShellContent
                ContentTemplate="{DataTemplate views:RecipesPage}"
                Route="RecipesPage" />
        </Tab>
        
        <Tab Title="Losuj">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Casino}"
                                 FontFamily="MaterialSymbolsOutlined"
                                 Size="24"/>
            </Tab.Icon>
            <ShellContent
                ContentTemplate="{DataTemplate views:RandomRecipePage}"
                Route="RandomRecipePage" />
        </Tab>
        
        <Tab Title="Kategorie">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Folder}"
                                 FontFamily="MaterialSymbolsOutlined"
                                 Size="24"/>
            </Tab.Icon>
            <ShellContent
                ContentTemplate="{DataTemplate views:CategoriesPage}"
                Route="CategoriesPage" />
        </Tab>
        
        <Tab Title="Logi">
            <Tab.Icon>
                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Bug_report}"
                                 FontFamily="MaterialSymbolsOutlined"
                                 Size="24"/>
            </Tab.Icon>
            <ShellContent
                ContentTemplate="{DataTemplate views:LogsPage}"
                Route="LogsPage" />
        </Tab>
    </TabBar>

</Shell>
