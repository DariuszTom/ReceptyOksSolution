<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
             xmlns:data="clr-namespace:ReceptyOks.Data"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialIcons;assembly=UraniumUI.Icons.MaterialIcons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ReceptyOks.Views.RecipeEditPage"
             x:DataType="vm:RecipeEditViewModel"
             Title="{Binding PageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Command="{Binding SaveCommand}"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            
            <!-- Zdjęcie -->
            <Border StrokeShape="RoundRectangle 16" 
                    Padding="0"
                    HeightRequest="180"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Gray400Brush}"
                            Offset="0,2"
                            Radius="8"
                            Opacity="0.1"/>
                </Border.Shadow>
                <Border.Behaviors>
                    <toolkit:TouchBehavior 
                        PressedScale="0.98"
                        PressedOpacity="0.9"
                        Command="{Binding PickImageCommand}"/>
                </Border.Behaviors>
                <Grid>
                    <Image Source="{Binding ImagePreview}" 
                           Aspect="AspectFill"
                           IsVisible="{Binding ImagePreview, Converter={StaticResource IsNotNullConverter}}"/>
                    <VerticalStackLayout HorizontalOptions="Center" 
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         IsVisible="{Binding ImagePreview, Converter={StaticResource IsNullConverter}}">
                        <Image HeightRequest="48" WidthRequest="48">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static icons:MaterialRegular.Add_a_photo}"
                                                 FontFamily="MaterialRegular"
                                                 Color="{StaticResource Gray400}"
                                                 Size="48"/>
                            </Image.Source>
                        </Image>
                        <Label Text="Dodaj zdjęcie" 
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
            
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Command="{Binding PickImageCommand}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        CornerRadius="20"
                        Padding="16,8">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialRegular.Photo_library}"
                                         FontFamily="MaterialRegular"
                                         Color="{StaticResource Primary}"
                                         Size="20"/>
                    </Button.ImageSource>
                </Button>
                <Button Command="{Binding TakePhotoCommand}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        CornerRadius="20"
                        Padding="16,8">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialRegular.Camera_alt}"
                                         FontFamily="MaterialRegular"
                                         Color="{StaticResource Primary}"
                                         Size="20"/>
                    </Button.ImageSource>
                </Button>
            </HorizontalStackLayout>

            <!-- Tytuł -->
            <material:TextField Title="Tytuł *" 
                                Text="{Binding Title}" 
                                Icon="{FontImageSource Glyph={x:Static icons:MaterialRegular.Title}, FontFamily=MaterialRegular, Size=20}"
                                AllowClear="True"/>

            <!-- Kategoria -->
            <material:PickerField Title="Kategoria"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  ItemDisplayBinding="{Binding Name}"
                                  Icon="{FontImageSource Glyph={x:Static icons:MaterialRegular.Category}, FontFamily=MaterialRegular, Size=20}"/>

            <!-- Czasy i porcje -->
            <Label Text="Szczegóły" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <material:TextField Grid.Column="0"
                                    Title="Przygotowanie (min)"
                                    Text="{Binding PreparationTimeMinutes}" 
                                    Keyboard="Numeric"
                                    Icon="{FontImageSource Glyph={x:Static icons:MaterialRegular.Schedule}, FontFamily=MaterialRegular, Size=18}"/>
                <material:TextField Grid.Column="1"
                                    Title="Gotowanie (min)"
                                    Text="{Binding CookingTimeMinutes}" 
                                    Keyboard="Numeric"
                                    Icon="{FontImageSource Glyph={x:Static icons:MaterialRegular.Outdoor_grill}, FontFamily=MaterialRegular, Size=18}"/>
                <material:TextField Grid.Column="2"
                                    Title="Porcje"
                                    Text="{Binding Servings}" 
                                    Keyboard="Numeric"
                                    Icon="{FontImageSource Glyph={x:Static icons:MaterialRegular.Group}, FontFamily=MaterialRegular, Size=18}"/>
            </Grid>

            <!-- Składniki -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                <Label Text="Składniki" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                <Button Grid.Column="1" 
                        Command="{Binding AddIngredientCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        CornerRadius="20"
                        Padding="12,6">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialRegular.Add}"
                                         FontFamily="MaterialRegular"
                                         Color="White"
                                         Size="18"/>
                    </Button.ImageSource>
                </Button>
            </Grid>

            <CollectionView ItemsSource="{Binding Ingredients}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditableIngredient">
                        <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12" 
                                Margin="0,6"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                                <material:PickerField Grid.Row="0" Grid.Column="0"
                                                      Title="Składnik"
                                                      ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeEditViewModel}}, Path=AvailableIngredients}"
                                                      SelectedItem="{Binding SelectedIngredient}"
                                                      ItemDisplayBinding="{Binding Name}"/>
                                <Button Grid.Row="0" Grid.Column="1" 
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeEditViewModel}}, Path=RemoveIngredientCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.ImageSource>
                                        <FontImageSource Glyph="{x:Static icons:MaterialRegular.Delete}"
                                                         FontFamily="MaterialRegular"
                                                         Color="#E53935"
                                                         Size="22"/>
                                    </Button.ImageSource>
                                </Button>
                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                      ColumnDefinitions="*,*,2*" ColumnSpacing="8">
                                    <material:TextField Grid.Column="0" 
                                                        Title="Ilość"
                                                        Text="{Binding Quantity}" 
                                                        Keyboard="Numeric"/>
                                    <material:TextField Grid.Column="1" 
                                                        Title="Jednostka"
                                                        Text="{Binding Unit}"/>
                                    <material:TextField Grid.Column="2" 
                                                        Title="Uwagi"
                                                        Text="{Binding Notes}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Instrukcje -->
            <Label Text="Przygotowanie" FontSize="18" FontAttributes="Bold" Margin="0,16,0,0"/>
            <material:EditorField Title="Instrukcje" 
                                  Text="{Binding Instructions}"/>

            <!-- Przyciski -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,24,0,20">
                <Button Grid.Column="0" 
                        Text="Anuluj" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1" 
                        Text="Zapisz" 
                        Command="{Binding SaveCommand}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialRegular.Save}"
                                         FontFamily="MaterialRegular"
                                         Color="White"
                                         Size="18"/>
                    </Button.ImageSource>
                </Button>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

