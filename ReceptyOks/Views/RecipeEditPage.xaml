<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
             xmlns:data="clr-namespace:ReceptyOks.Data"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:ReceptyOks.Controls"
             x:Class="ReceptyOks.Views.RecipeEditPage"
             x:DataType="vm:RecipeEditViewModel"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BlackBrownPurpleGradient}}"
             Title="{Binding PageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz" Clicked="OnSaveClicked"/>
        <ToolbarItem Text="🔧 TEST" Clicked="OnTestEditorClicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Zdjęcie -->
            <Border StrokeShape="RoundRectangle 16" 
                    Padding="0"
                    HeightRequest="180"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Gray400Brush}"
                            Offset="0,2"
                            Radius="8"
                            Opacity="0.1"/>
                </Border.Shadow>

                <Grid>
                    <Image Source="{Binding ImagePreview}" 
                           Aspect="AspectFill"
                           IsVisible="{Binding ImagePreview, Converter={StaticResource IsNotNullConverter}}"/>

                    <!-- tappable full-area placeholder when there's no image -->
                    <Button
                        IsVisible="{Binding ImagePreview, Converter={StaticResource IsNullConverter}}"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        Padding="0"
                        Margin="0"
                        BorderWidth="0"
                        Command="{Binding PickImageCommand}"/>

                    <!-- overlay remove button -->
                    <Button
                        IsVisible="{Binding ImagePreview, Converter={StaticResource IsNotNullConverter}}"
                        BackgroundColor="#80000000"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="10"
                        Command="{Binding RemoveImageCommand}">
                        <Button.ImageSource>
                            <FontImageSource Glyph="" FontFamily="MaterialSymbolsOutlined" Color="White" Size="20" />
                        </Button.ImageSource>
                    </Button>

                    <VerticalStackLayout HorizontalOptions="Center" 
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         IsVisible="{Binding ImagePreview, Converter={StaticResource IsNullConverter}}">
                        <Image HeightRequest="48" WidthRequest="48">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add_a_photo}"
                                                 FontFamily="MaterialSymbolsOutlined"
                                                 Color="{StaticResource Gray400}"
                                                 Size="48"/>
                            </Image.Source>
                        </Image>
                        <Label Text="Dodaj zdjęcie" 
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Command="{Binding PickImageCommand}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        CornerRadius="20"
                        Padding="16,8">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Photo_library}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="{StaticResource Primary}"
                                         Size="20"/>
                    </Button.ImageSource>
                </Button>
                <Button Command="{Binding TakePhotoCommand}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        CornerRadius="20"
                        Padding="16,8">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Photo_camera}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="{StaticResource Primary}"
                                         Size="20"/>
                    </Button.ImageSource>
                </Button>
            </HorizontalStackLayout>

            <!-- Tytuł -->
            <material:TextField Title="Tytuł *" 
                                Text="{Binding Title}" 
                                Icon="{FontImageSource Glyph={x:Static icons:MaterialOutlined.Title}, FontFamily=MaterialSymbolsOutlined, Size=20}"
                                AllowClear="True"/>

            <!-- Opis -->
            <material:EditorField Title="Opis" 
                                  Text="{Binding Description}"/>

            <!-- Kategoria -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Kategoria" FontSize="14" TextColor="{StaticResource Gray500}"/>
                <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Grid.Column="0" 
                               HeightRequest="20" 
                               WidthRequest="20"
                               Margin="0,0,8,0"
                               VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Category}"
                                                 FontFamily="MaterialSymbolsOutlined"
                                                 Color="{StaticResource Primary}"
                                                 Size="20"/>
                            </Image.Source>
                        </Image>
                        <Picker Grid.Column="1"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}"
                                ItemDisplayBinding="{Binding Name}"
                                VerticalOptions="Center"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Czasy i porcje -->
            <Label Text="Szczegóły" FontSize="16" FontAttributes="Bold" Margin="0,6,0,0"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Przygotowanie (min)" FontSize="12" FontAttributes="Bold"/>
                    <HorizontalStackLayout Spacing="3">
                        <Entry Text="{Binding PreparationTimeMinutes, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="60" VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="1">
                            <Button Command="{Binding IncrementPreparationTimeCommand}"
                                    Text="+"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                            <Button Command="{Binding DecrementPreparationTimeCommand}"
                                    Text="-"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Gotowanie (min)" FontSize="12" FontAttributes="Bold"/>
                    <HorizontalStackLayout Spacing="3">
                        <Entry Text="{Binding CookingTimeMinutes, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="60" VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="1">
                            <Button Command="{Binding IncrementCookingTimeCommand}"
                                    Text="+"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                            <Button Command="{Binding DecrementCookingTimeCommand}"
                                    Text="-"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2">
                    <Label Text="Porcje" FontSize="12" FontAttributes="Bold"/>
                    <HorizontalStackLayout Spacing="3">
                        <Entry Text="{Binding Servings, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="60" VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="1">
                            <Button Command="{Binding IncrementServingsCommand}"
                                    Text="+"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                            <Button Command="{Binding DecrementServingsCommand}"
                                    Text="-"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- Składniki -->
       <toolkit:Expander IsExpanded="True">
  <toolkit:Expander.Header>
          <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
    StrokeThickness="1"
  StrokeShape="RoundRectangle 8"
   Padding="12,10"
           Margin="0,16,0,0"
       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
          <Grid ColumnDefinitions="Auto,*,Auto">
           <Image Grid.Column="0" HeightRequest="20" WidthRequest="20" Margin="0,0,10,0">
               <Image.Source>
 <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Restaurant}"
     FontFamily="MaterialSymbolsOutlined"
             Color="{StaticResource Primary}"
             Size="20"/>
  </Image.Source>
           </Image>
          <Label Grid.Column="1" 
Text="{Binding Ingredients.Count, StringFormat='Składniki ({0})'}" 
  FontSize="18" 
  FontAttributes="Bold" 
             VerticalOptions="Center"/>
       <Image Grid.Column="2" HeightRequest="20" WidthRequest="20">
  <Image.Source>
      <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Expand_more}"
     FontFamily="MaterialSymbolsOutlined"
           Color="{StaticResource Gray500}"
    Size="20"/>
</Image.Source>
       </Image>
           </Grid>
            </Border>
     </toolkit:Expander.Header>
     <toolkit:Expander.Content>
   <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Ingredients}">
           <CollectionView.ItemTemplate>
     <DataTemplate x:DataType="vm:EditableIngredient">
              <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
     StrokeShape="RoundRectangle 12"
         Padding="12" 
                 Margin="0,6"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
           <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
    <material:TextField Grid.Row="0" Grid.Column="0" FontSize="16"
               Title="Składnik"
                Text="{Binding IngredientName}"/>
         <Button Grid.Row="0" Grid.Column="1" 
      BackgroundColor="Transparent"
      VerticalOptions="Center"
     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeEditViewModel}}, Path=RemoveIngredientCommand}"
     CommandParameter="{Binding .}">
          <Button.ImageSource>
  <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Delete}"
  FontFamily="MaterialSymbolsOutlined"
         Color="#E53935"
    Size="22"/>
     </Button.ImageSource>
      </Button>
      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
     ColumnDefinitions="*,*,*" ColumnSpacing="6">
          <material:TextField Grid.Column="0" FontSize="14" SelectAllTextOnFocus="True"
                    Title="Ilość"
           Text="{Binding Quantity}" 
       Keyboard="Numeric"/>
  <material:PickerField Grid.Column="1" FontSize="12"
         Title="Jednostka"
      ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeEditViewModel}}, Path=AvailableUnits, Mode=OneTime}"
               SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
         VerticalOptions="Center"
       BackgroundColor="Transparent"/>
     <material:TextField Grid.Column="2" FontSize="12"
Title="Uwagi"
     Text="{Binding Notes}"/>
         </Grid>
    </Grid>
 </Border>
    </DataTemplate>
    </CollectionView.ItemTemplate>
       </CollectionView>
                 <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
   <Button Grid.Column="1" VerticalOptions="End"
   Command="{Binding AddIngredientCommand}"
        BackgroundColor="{StaticResource Primary}"
            CornerRadius="20"
 Padding="12,6">     
    <Button.ImageSource>
          <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add}"
          FontFamily="MaterialSymbolsOutlined"
                  Color="White"
             Size="18"/>
         </Button.ImageSource>
                 </Button>
       </Grid>
            </VerticalStackLayout>
         </toolkit:Expander.Content>
            </toolkit:Expander>
            <!-- Instrukcje - Rich Text Editor -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
    <Label Text="Przygotowanie" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
         <!-- Recording indicator GIF - shows in center when listening -->
   <Image Grid.Column="1"
           Source="recordingmicrofone2.gif"
               HeightRequest="40"
              WidthRequest="40"
                  Aspect="AspectFit"
                HorizontalOptions="Center"
             VerticalOptions="Center"
             IsAnimationPlaying="{Binding IsListening}"
             IsVisible="{Binding IsListening}"/>
                <HorizontalStackLayout Grid.Column="2" Spacing="8">
                    <Button Command="{Binding ScanInstructionsFromGalleryCommand}" Style="{StaticResource GradientAddButton}"
         BackgroundColor="Transparent"
                    BorderColor="{StaticResource Primary}"
                BorderWidth="1"
               CornerRadius="20"
        Padding="12,6"
           ToolTipProperties.Text="Skanuj z galerii">
      <Button.ImageSource>
         <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Document_scanner}"
          FontFamily="MaterialSymbolsOutlined"
        Color="{StaticResource Primary}"
         Size="18"/>
           </Button.ImageSource>
     </Button>
        <Button Command="{Binding ScanInstructionsFromCameraCommand}" Style="{StaticResource GradientAddButton}"
            BackgroundColor="Transparent"
     BorderColor="{StaticResource Primary}"
     BorderWidth="1"
     CornerRadius="20"
  Padding="12,6"
         ToolTipProperties.Text="Skanuj z kamery">
         <Button.ImageSource>
<FontImageSource Glyph="{x:Static icons:MaterialOutlined.Photo_camera}"
     FontFamily="MaterialSymbolsOutlined"
  Color="{StaticResource Primary}"
          Size="18"/>
           </Button.ImageSource>
     </Button>
    <Button Command="{Binding ScanInstructionsFromMicrophoneCommand}" Style="{StaticResource GradientAddButton}"
          BackgroundColor="Transparent"
  BorderColor="{StaticResource Primary}"
             BorderWidth="1"
               CornerRadius="20"
             Padding="12,6"
            ToolTipProperties.Text="Skanuj z kamery">  
       <Button.ImageSource>
        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Mic}"
     FontFamily="MaterialSymbolsOutlined"
  Color="{StaticResource Primary}"
      Size="18"/>
       </Button.ImageSource>
        </Button>
          </HorizontalStackLayout>
            </Grid>
            <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    HeightRequest="350"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                <controls:RichTextEditor x:Name="InstructionsEditor" HtmlContent="{Binding Instructions}"/>
            </Border>

            <!-- Przyciski -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,24,0,20">
                <Button Grid.Column="0" 
                        Text="Anuluj" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                        CornerRadius="12"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1" 
                        Text="Zapisz"
                        Style="{StaticResource GradientAddButton}"
                        Clicked="OnSaveClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Save}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="White"
                                         Size="18"/>
                    </Button.ImageSource>
                </Button>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>