<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
             xmlns:data="clr-namespace:ReceptyOks.Data"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:ReceptyOks.Controls"
             xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             xmlns:blazorComponents="clr-namespace:ReceptyOks.BlazorComponents.Components;assembly=ReceptyOks.BlazorComponents"
             x:Class="ReceptyOks.Views.RecipeEditPage"
             x:DataType="vm:RecipeEditViewModel"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BlackBrownPurpleGradient}}"
             Title="{Binding PageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Zapisz 🗄" Clicked="OnSaveClicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Zdjęcie -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="0"
                    HeightRequest="180"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                    StrokeThickness="0"
                    IsVisible="{Binding IsEditorFullScreen, Converter={StaticResource InvertedBoolConverter}}">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Gray400Brush}"
                            Offset="0,2"
                            Radius="8"
                            Opacity="0.1"/>
                </Border.Shadow>

                <Grid>
                    <Image Source="{Binding ImagePreview}"
                           Aspect="AspectFill"
                           IsVisible="{Binding ImagePreview, Converter={StaticResource IsNotNullConverter}}"/>

                    <!-- tappable full-area placeholder when there's no image -->
                    <Button
                        IsVisible="{Binding ImagePreview, Converter={StaticResource IsNullConverter}}"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        Padding="0"
                        Margin="0"
                        BorderWidth="0"
                        Command="{Binding PickImageCommand}"/>

                    <!-- overlay remove button -->
                    <Button
                        IsVisible="{Binding ImagePreview, Converter={StaticResource IsNotNullConverter}}"
                        BackgroundColor="#80000000"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="10"
                        Command="{Binding RemoveImageCommand}">
                        <Button.ImageSource>
                            <FontImageSource Glyph="" FontFamily="MaterialSymbolsOutlined" Color="White" Size="20" />
                        </Button.ImageSource>
                    </Button>

                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8"
                                         IsVisible="{Binding ImagePreview, Converter={StaticResource IsNullConverter}}">
                        <Image HeightRequest="48" WidthRequest="48">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add_a_photo}"
                                                 FontFamily="MaterialSymbolsOutlined"
                                                 Color="{StaticResource Gray400}"
                                                 Size="48"/>
                            </Image.Source>
                        </Image>
                        <Label Text="Dodaj zdjęcie"
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center"
                                     IsVisible="{Binding IsEditorFullScreen, Converter={StaticResource InvertedBoolConverter}}">
                <Button Command="{Binding PickImageCommand}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        CornerRadius="20"
                        Padding="16,8">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Photo_library}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="{StaticResource Primary}"
                                         Size="20"/>
                    </Button.ImageSource>
                </Button>
                <Button Command="{Binding TakePhotoCommand}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        CornerRadius="20"
                        Padding="16,8">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Photo_camera}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="{StaticResource Primary}"
                                         Size="20"/>
                    </Button.ImageSource>
                </Button>
            </HorizontalStackLayout>

            <!-- Tytuł -->
            <material:TextField Title="Tytuł *"
                                Text="{Binding Title}"
                                Icon="{FontImageSource Glyph={x:Static icons:MaterialOutlined.Title}, FontFamily=MaterialSymbolsOutlined, Size=20}"
                                AllowClear="True"
                                IsVisible="{Binding IsEditorFullScreen, Converter={StaticResource InvertedBoolConverter}}"/>

            <!-- Opis -->
            <material:EditorField Title="Opis"
                                  Text="{Binding Description}"
                                  IsVisible="{Binding IsEditorFullScreen, Converter={StaticResource InvertedBoolConverter}}"/>

            <!-- Kategoria -->
            <VerticalStackLayout Spacing="4"
                                 IsVisible="{Binding IsEditorFullScreen, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="Kategoria" FontSize="14" TextColor="{StaticResource Gray500}"/>
                <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Grid.Column="0"
                               HeightRequest="20"
                               WidthRequest="20"
                               Margin="0,0,8,0"
                               VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Category}"
                                                 FontFamily="MaterialSymbolsOutlined"
                                                 Color="{StaticResource Primary}"
                                                 Size="20"/>
                            </Image.Source>
                        </Image>
                        <Picker Grid.Column="1"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}"
                                ItemDisplayBinding="{Binding Name}"
                                VerticalOptions="Center"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Czasy i porcje -->
            <Label Text="Szczegóły" FontSize="16" FontAttributes="Bold" Margin="0,6,0,0"
                   IsVisible="{Binding IsEditorFullScreen, Converter={StaticResource InvertedBoolConverter}}"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"
                  IsVisible="{Binding IsEditorFullScreen, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Przygotowanie (min)" FontSize="12" FontAttributes="Bold"/>
                    <HorizontalStackLayout Spacing="3">
                        <Entry Text="{Binding PreparationTimeMinutes, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="60" VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="1">
                            <Button Command="{Binding IncrementPreparationTimeCommand}"
                                    Text="+"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                            <Button Command="{Binding DecrementPreparationTimeCommand}"
                                    Text="-"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Gotowanie (min)" FontSize="12" FontAttributes="Bold"/>
                    <HorizontalStackLayout Spacing="3">
                        <Entry Text="{Binding CookingTimeMinutes, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="60" VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="1">
                            <Button Command="{Binding IncrementCookingTimeCommand}"
                                    Text="+"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                            <Button Command="{Binding DecrementCookingTimeCommand}"
                                    Text="-"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2">
                    <Label Text="Porcje" FontSize="12" FontAttributes="Bold"/>
                    <HorizontalStackLayout Spacing="3">
                        <Entry Text="{Binding Servings, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="60" VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="1">
                            <Button Command="{Binding IncrementServingsCommand}"
                                    Text="+"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                            <Button Command="{Binding DecrementServingsCommand}"
                                    Text="-"
                                    WidthRequest="22"
                                    HeightRequest="16"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    Padding="0"
                                    CornerRadius="3"
                                    BackgroundColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- Składniki -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding IsEditorFullScreen, Converter={StaticResource InvertedBoolConverter}}">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,16,0,0">
                    <Image HeightRequest="20" WidthRequest="20" Margin="0,0,10,0" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Restaurant}"
                                             FontFamily="MaterialSymbolsOutlined"
                                             Color="{StaticResource Primary}"
                                             Size="20"/>
                        </Image.Source>
                    </Image>
                    <Label Grid.Column="1"
                           Text="{Binding Ingredients.Count, StringFormat='Składniki ({0})'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Ingriedent control for adding -->
                <controls:Ingriedent ItemName="{Binding NewIngredientName}"
                                     ItemQuantity="{Binding NewIngredientQuantity}"
                                     SelectedUnit="{Binding NewIngredientUnit}"
                                     AvailableUnits="{Binding AvailableUnits}"
                                     IngredientSuggestions="{Binding IngredientSuggestions}"
                                     AddCommand="{Binding AddIngredientCommand}"
                                     ErrorMessage="{Binding IngredientErrorMessage}"/>

                <!-- Chips for added ingredients -->
                <FlexLayout BindableLayout.ItemsSource="{Binding Ingredients}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignItems="Center"
                            AlignContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EditableIngredient">
                            <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource BlazorGradient}}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="14,6,8,6"
                                    Margin="4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray800}}">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0"
                                           Text="{Binding ChipDisplayName}"
                                           FontSize="14"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                    <ImageButton Grid.Column="2"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeEditViewModel}}, Path=RemoveIngredientCommand}"
                                                 CommandParameter="{Binding .}"
                                                 HeightRequest="24"
                                                 WidthRequest="24"
                                                 BackgroundColor="Transparent"
                                                 Margin="12,0,0,0"
                                                 VerticalOptions="Center">
                                        <ImageButton.Source>
                                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
                                                             FontFamily="MaterialSymbolsOutlined"
                                                             Color="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                                             Size="16"/>
                                        </ImageButton.Source>
                                    </ImageButton>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Instrukcje - Rich Text Editor -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">
                <Label Text="Przygotowanie" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                <!-- Recording indicator GIF - shows in center when listening -->
                <Image Grid.Column="1"
                       Source="recordingmicrofone2.gif"
                       HeightRequest="40"
                       WidthRequest="40"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       IsAnimationPlaying="{Binding IsListening}"
                       IsVisible="{Binding IsListening}"/>
                <HorizontalStackLayout Grid.Column="2" Spacing="8">
                    <Button Command="{Binding ScanInstructionsFromGalleryCommand}" Style="{StaticResource GradientAddButton}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            CornerRadius="20"
                            Padding="12,6"
                            ToolTipProperties.Text="Skanuj z galerii">
                        <Button.ImageSource>
                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Document_scanner}"
                                             FontFamily="MaterialSymbolsOutlined"
                                             Color="{StaticResource Primary}"
                                             Size="18"/>
                        </Button.ImageSource>
                    </Button>
                    <Button Command="{Binding ScanInstructionsFromCameraCommand}" Style="{StaticResource GradientAddButton}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            CornerRadius="20"
                            Padding="12,6"
                            ToolTipProperties.Text="Skanuj z kamery">
                        <Button.ImageSource>
                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Photo_camera}"
                                             FontFamily="MaterialSymbolsOutlined"
                                             Color="{StaticResource Primary}"
                                             Size="18"/>
                        </Button.ImageSource>
                    </Button>
                    <Button x:Name="MicrophoneButton"
                            Command="{Binding ScanInstructionsFromMicrophoneCommand}"
                            Style="{StaticResource GradientAddButton}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            CornerRadius="20"
                            Padding="12,6"
                            ToolTipProperties.Text="Nagrywaj głos">
                        <Button.ImageSource>
                            <FontImageSource x:Name="MicrophoneIcon"
                                             Glyph="&#xe029;"
                                             FontFamily="MaterialSymbolsOutlined"
                                             Color="{StaticResource Primary}"
                                             Size="18"/>
                        </Button.ImageSource>
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsListening}" Value="True">
                                <Setter Property="BackgroundColor" Value="#E53935"/>
                                <Setter Property="BorderColor" Value="#E53935"/>
                                <Setter Property="ImageSource">
                                    <Setter.Value>
                                        <FontImageSource Glyph="&#xe034;"
                                                         FontFamily="MaterialSymbolsOutlined"
                                                         Color="White"
                                                         Size="18"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
                <Border Grid.Column="3"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        HeightRequest="36"
                        WidthRequest="36"
                        Margin="4,0,0,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleEditorFullScreenCommand}"/>
                    </Border.GestureRecognizers>
                    <Image HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Fullscreen}"
                                             FontFamily="MaterialSymbolsOutlined"
                                             Color="{StaticResource Primary}"
                                             Size="20"/>
                        </Image.Source>
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding IsEditorFullScreen}" Value="True">
                                <Setter Property="Source">
                                    <Setter.Value>
                                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Fullscreen_exit}"
                                                         FontFamily="MaterialSymbolsOutlined"
                                                         Color="{StaticResource Primary}"
                                                         Size="20"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                </Border>
            </Grid>
            <Border x:Name="EditorBorder"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    HeightRequest="400"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                <blazor:BlazorWebView x:Name="InstructionsEditorWebView" HostPage="wwwroot/editor.html"
                                      BlazorWebViewInitialized="OnBlazorWebViewInitialized">
                    <blazor:BlazorWebView.RootComponents>
                        <blazor:RootComponent Selector="#app"
                                              x:Name="InstructionsEditorRoot"
                                              ComponentType="{x:Type blazorComponents:BlazorRichtTextEditor}" />
                    </blazor:BlazorWebView.RootComponents>
                </blazor:BlazorWebView>
            </Border>

            <!-- Przyciski -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,24,0,20"
                  IsVisible="{Binding IsEditorFullScreen, Converter={StaticResource InvertedBoolConverter}}">
                <Button Grid.Column="0"
                        Text="Anuluj"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                        CornerRadius="12"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="Zapisz"
                        Style="{StaticResource GradientAddButton}"
                        Clicked="OnSaveClicked">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Save}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="White"
                                         Size="18"/>
                    </Button.ImageSource>
                </Button>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
