<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
             xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialIcons;assembly=UraniumUI.Icons.MaterialIcons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ReceptyOks.Views.RecipeDetailPage"
             x:DataType="vm:RecipeDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">
        <!-- Hero Image with overlay header -->
        <ScrollView Grid.RowSpan="2">
            <VerticalStackLayout Spacing="0">
                <!-- Hero Image Area -->
                <Grid HeightRequest="280">
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <Image Source="{Binding RecipeImage}" 
                               Aspect="AspectFill"
                               IsVisible="{Binding RecipeImage, Converter={StaticResource IsNotNullConverter}}"/>
                    </Border>
                    <!-- Default image when no photo -->
                    <Image Aspect="AspectFill" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center"
                           IsVisible="{Binding RecipeImage, Converter={StaticResource IsNullConverter}}">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static icons:MaterialRegular.Restaurant}"
                                             FontFamily="MaterialRegular"
                                             Color="{StaticResource Gray400}"
                                             Size="80"/>
                        </Image.Source>
                    </Image>
                    <!-- Gradient overlay -->
                    <BoxView>
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#80000000" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="0.4"/>
                                <GradientStop Color="Transparent" Offset="0.6"/>
                                <GradientStop Color="#60000000" Offset="1"/>
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <!-- Time badge -->
                    <Border HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="16"
                            Padding="12,8"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#E0000000">
                        <HorizontalStackLayout Spacing="6">
                            <Image HeightRequest="16" WidthRequest="16">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static icons:MaterialRegular.Schedule}"
                                                     FontFamily="MaterialRegular"
                                                     Color="White"
                                                     Size="16"/>
                                </Image.Source>
                            </Image>
                            <Label FontSize="14" TextColor="White" FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Recipe.PreparationTimeMinutes}"/>
                                        <Span Text=" + "/>
                                        <Span Text="{Binding Recipe.CookingTimeMinutes}"/>
                                        <Span Text=" min"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Content Card -->
                <Border Margin="0,-24,0,0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24,24,0,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="20" Padding="20,24,20,32">
                        
                        <!-- Title and Category -->
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding Recipe.Title}" 
                                   FontSize="26" 
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                            
                            <!-- Category Badge -->
                            <Border BackgroundColor="{StaticResource Primary}" 
                                    Padding="14,8" 
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding Category, Converter={StaticResource IsNotNullConverter}}">
                                <HorizontalStackLayout Spacing="6">
                                    <Image HeightRequest="16" WidthRequest="16">
                                        <Image.Source>
                                            <FontImageSource Glyph="{x:Static icons:MaterialRegular.Category}"
                                                             FontFamily="MaterialRegular"
                                                             Color="White"
                                                             Size="16"/>
                                        </Image.Source>
                                    </Image>
                                    <Label Text="{Binding Category.Name}" 
                                           TextColor="White" 
                                           FontSize="13"
                                           FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Quick Stats -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <Border Grid.Column="0" 
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Image HeightRequest="28" WidthRequest="28" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource Glyph="{x:Static icons:MaterialRegular.Schedule}"
                                                             FontFamily="MaterialRegular"
                                                             Color="{StaticResource Primary}"
                                                             Size="28"/>
                                        </Image.Source>
                                    </Image>
                                    <Label FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" 
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Recipe.PreparationTimeMinutes}"/>
                                                <Span Text="m"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="Przygotowanie" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" 
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Image HeightRequest="28" WidthRequest="28" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource Glyph="{x:Static icons:MaterialRegular.Local_fire_department}"
                                                             FontFamily="MaterialRegular"
                                                             Color="#FF6B35"
                                                             Size="28"/>
                                        </Image.Source>
                                    </Image>
                                    <Label FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Recipe.CookingTimeMinutes}"/>
                                                <Span Text="m"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="Gotowanie" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" 
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Image HeightRequest="28" WidthRequest="28" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource Glyph="{x:Static icons:MaterialRegular.Group}"
                                                             FontFamily="MaterialRegular"
                                                             Color="{StaticResource Primary}"
                                                             Size="28"/>
                                        </Image.Source>
                                    </Image>
                                    <Label Text="{Binding Recipe.Servings}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                    <Label Text="Porcji" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Składniki Section -->
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="10">
                                <Border BackgroundColor="{StaticResource Primary}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        HeightRequest="36"
                                        WidthRequest="36">
                                    <Image HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource Glyph="{x:Static icons:MaterialRegular.Shopping_basket}"
                                                             FontFamily="MaterialRegular"
                                                             Color="White"
                                                             Size="20"/>
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <Label Text="Składniki" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                            </HorizontalStackLayout>
                            
                            <CollectionView ItemsSource="{Binding Ingredients}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecipeIngredientDisplay">
                                        <Border Margin="0,4"
                                                Padding="14,12"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border BackgroundColor="{StaticResource Secondary}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10"
                                                        HeightRequest="28"
                                                        WidthRequest="28">
                                                    <Image HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Image.Source>
                                                            <FontImageSource Glyph="{x:Static icons:MaterialRegular.Check}"
                                                                             FontFamily="MaterialRegular"
                                                                             Color="{StaticResource Primary}"
                                                                             Size="16"/>
                                                        </Image.Source>
                                                    </Image>
                                                </Border>
                                                <Label Grid.Column="1" 
                                                       Text="{Binding DisplayText}" 
                                                       FontSize="15"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- Instrukcje Section -->
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="10">
                                <Border BackgroundColor="{StaticResource Primary}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        HeightRequest="36"
                                        WidthRequest="36">
                                    <Image HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource Glyph="{x:Static icons:MaterialRegular.Menu_book}"
                                                             FontFamily="MaterialRegular"
                                                             Color="White"
                                                             Size="20"/>
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <Label Text="Przygotowanie" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                            </HorizontalStackLayout>
                            
                            <Border Padding="16"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
                                <Label Text="{Binding Recipe.Instructions}" 
                                       FontSize="15"
                                       LineHeight="1.6"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating header with back button -->
        <Grid Grid.Row="0" 
              Padding="12,12"
              ColumnDefinitions="Auto,*,Auto,Auto">
            <!-- Back button -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    HeightRequest="44"
                    WidthRequest="44"
                    BackgroundColor="#80000000">
                <Border.Behaviors>
                    <toolkit:TouchBehavior 
                        PressedScale="0.9"
                        PressedOpacity="0.7"
                        Command="{Binding GoBackCommand}"/>
                </Border.Behaviors>
                <Image HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static icons:MaterialRegular.Arrow_back}"
                                         FontFamily="MaterialRegular"
                                         Color="White"
                                         Size="22"/>
                    </Image.Source>
                </Image>
            </Border>
            
            <!-- Edit button -->
            <Border Grid.Column="2"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    HeightRequest="44"
                    WidthRequest="44"
                    BackgroundColor="#80000000"
                    Margin="0,0,8,0">
                <Border.Behaviors>
                    <toolkit:TouchBehavior 
                        PressedScale="0.9"
                        PressedOpacity="0.7"
                        Command="{Binding EditRecipeCommand}"/>
                </Border.Behaviors>
                <Image HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static icons:MaterialRegular.Edit}"
                                         FontFamily="MaterialRegular"
                                         Color="White"
                                         Size="22"/>
                    </Image.Source>
                </Image>
            </Border>
            
            <!-- Delete button -->
            <Border Grid.Column="3"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    HeightRequest="44"
                    WidthRequest="44"
                    BackgroundColor="#80000000">
                <Border.Behaviors>
                    <toolkit:TouchBehavior 
                        PressedScale="0.9"
                        PressedOpacity="0.7"
                        Command="{Binding DeleteRecipeCommand}"/>
                </Border.Behaviors>
                <Image HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static icons:MaterialRegular.Delete}"
                                         FontFamily="MaterialRegular"
                                         Color="#FF6B6B"
                                         Size="22"/>
                    </Image.Source>
                </Image>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
