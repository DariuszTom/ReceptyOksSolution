<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
     x:Class="ReceptyOks.Views.UserDetailsPage"
 xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
  xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
       xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
     xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
        xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
       x:DataType="vm:UserDetailsViewModel"
             Shell.NavBarIsVisible="False"
       Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BlackBrownPurpleGradient}}"
 Title="Użytkownik">

    <Grid RowDefinitions="Auto,*">
    <!-- Custom Header -->
        <Grid Grid.Row="0" Padding="20,16" ColumnDefinitions="*,Auto" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
          <Grid.Shadow>
                <Shadow Brush="{StaticResource Gray400Brush}" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Grid.Shadow>
            <VerticalStackLayout VerticalOptions="Center">
    <Label Text="Użytkownik" Style="{StaticResource PageTitle}" FontSize="24"/>
                <Label Text="Szczegóły konta użytkownika" Style="{StaticResource CaptionLabel}"/>
            </VerticalStackLayout>
            <Image Grid.Column="1" HeightRequest="32" WidthRequest="32" VerticalOptions="Center">
        <Image.Source>
           <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Person}"
      FontFamily="MaterialSymbolsOutlined"
      Color="{StaticResource Primary}"
            Size="32"/>
           </Image.Source>
   </Image>
        </Grid>

 <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

       <!-- User Info Card -->
        <Border StrokeShape="RoundRectangle 16"
         StrokeThickness="1"
    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
      Padding="20">
         <Border.Shadow>
         <Shadow Brush="#00000030" Offset="0,4" Radius="12" Opacity="0.2"/>
            </Border.Shadow>

        <VerticalStackLayout Spacing="20">

                <!-- Name Field -->
      <material:TextField Title="Imię i nazwisko"
    Text="{Binding UserDetails.Name}"
            AccentColor="{StaticResource Primary}"
          TitleColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
     TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
             BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
     AllowClear="True"
      MaxLength="100">
                   <material:TextField.Icon>
   <FontImageSource FontFamily="MaterialSymbolsOutlined"
     Glyph="{x:Static icons:MaterialOutlined.Person}"
      Color="{StaticResource Primary}"
              Size="24"/>
       </material:TextField.Icon>
       </material:TextField>

       <!-- Email Field -->
               <material:TextField Title="Email"
                Text="{Binding UserDetails.Email}"
     Keyboard="Email"
        AccentColor="{StaticResource Primary}"
          TitleColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
          TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
    BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
  AllowClear="True"
    MaxLength="256">
  <material:TextField.Icon>
         <FontImageSource FontFamily="MaterialSymbolsOutlined"
 Glyph="{x:Static icons:MaterialOutlined.Mail}"
    Color="{StaticResource Primary}"
      Size="24"/>
               </material:TextField.Icon>
      </material:TextField>

    <!-- Phone Field -->
            <material:TextField Title="Numer telefonu"
           Text="{Binding UserDetails.PhoneNumber}"
      Keyboard="Telephone"
         AccentColor="{StaticResource Primary}"
 TitleColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
          TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
               BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
        AllowClear="True"
      MaxLength="20">
        <material:TextField.Icon>
<FontImageSource FontFamily="MaterialSymbolsOutlined"
          Glyph="{x:Static icons:MaterialOutlined.Phone_android}"
              Color="{StaticResource Primary}"
             Size="24"/>
          </material:TextField.Icon>
       </material:TextField>

     </VerticalStackLayout>
  </Border>

   <!-- Account Info Card -->
        <Border StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
   Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                    Padding="20">
          <Border.Shadow>
    <Shadow Brush="#00000030" Offset="0,4" Radius="12" Opacity="0.2"/>
     </Border.Shadow>

   <VerticalStackLayout Spacing="12">
     <Label Text="Informacje o koncie"
         FontSize="16"
  FontAttributes="Bold"
       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>

                 <BoxView HeightRequest="1" 
          Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
          Margin="0,4"/>

        <!-- User ID -->
       <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
           <Image Grid.Column="0" HeightRequest="20" WidthRequest="20" VerticalOptions="Center">
            <Image.Source>
  <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Badge}"
  FontFamily="MaterialSymbolsOutlined"
      Color="{StaticResource Primary}"
      Size="20"/>
     </Image.Source>
   </Image>
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
      <Label Text="ID użytkownika"
     FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
    <Label Text="{Binding UserDetails.Id}"
  FontSize="14"
       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
             </VerticalStackLayout>
    </Grid>

         <!-- Registration Date -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
     <Image Grid.Column="0" HeightRequest="20" WidthRequest="20" VerticalOptions="Center">
      <Image.Source>
   <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Calendar_today}"
   FontFamily="MaterialSymbolsOutlined"
Color="{StaticResource Primary}"
 Size="20"/>
                </Image.Source>
     </Image>
         <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
    <Label Text="Data rejestracji"
            FontSize="12"
           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
   <Label Text="{Binding UserDetails.AddOn, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
           FontSize="14"
            TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
            </VerticalStackLayout>
          </Grid>

            </VerticalStackLayout>
                </Border>

   </VerticalStackLayout>
</ScrollView>
    </Grid>
</ContentPage>