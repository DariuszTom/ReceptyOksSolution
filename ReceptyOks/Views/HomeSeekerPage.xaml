<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReceptyOks.Views.HomeSeekerPage"
             x:Name="HomeSeekerPageRoot"
             xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
             xmlns:hs="clr-namespace:ReceptyOks.Models.HomeSeeker"
             xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:DataType="vm:HomeSeekerViewModel"
             Shell.NavBarIsVisible="False"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BlackBrownPurpleGradient}}"
             Title="Domy">

    <ContentPage.Resources>
        <Style x:Key="HsCard" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="HsText" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
        </Style>
        <Style x:Key="HsMuted" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
        </Style>
        <Style x:Key="HsTab" TargetType="Button">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <Grid.Shadow>
                <Shadow Brush="{StaticResource Gray400Brush}" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Grid.Shadow>
            <Button Grid.Column="0"
                    Padding="8"
                    CornerRadius="10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                    VerticalOptions="Center"
                    Command="{Binding GoBackCommand}">
                <Button.ImageSource>
                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Arrow_back}"
                                     FontFamily="MaterialSymbolsOutlined"
                                     Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                     Size="24"/>
                </Button.ImageSource>
            </Button>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="HomeSeeker" Style="{StaticResource PageTitle}" FontSize="24"/>
                <Label Text="{Binding ProfileStatusText}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    Padding="8"
                    CornerRadius="10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                    VerticalOptions="Center"
                    Command="{Binding LoadCommand}">
                <Button.ImageSource>
                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Refresh}"
                                     FontFamily="MaterialSymbolsOutlined"
                                     Color="{StaticResource Primary}"
                                     Size="24"/>
                </Button.ImageSource>
            </Button>
        </Grid>

        <!-- Section switcher -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="16,12,16,4">
            <Button Grid.Column="0" Text="Ogłoszenia" Style="{StaticResource HsTab}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static vm:HomeSeekerSection.Listings}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsListingsSection}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="Skany" Style="{StaticResource HsTab}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static vm:HomeSeekerSection.Scans}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsScansSection}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2" Text="Profil" Style="{StaticResource HsTab}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static vm:HomeSeekerSection.Profile}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsProfileSection}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Error banner -->
        <Border Grid.Row="2" Margin="16,8,16,0" Padding="12,8" StrokeThickness="0"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="#33ED0241"
                IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource PinkColor}" FontSize="13"/>
        </Border>

        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Start"
                           Margin="0,24"
                           ZIndex="1"/>

        <!-- ===== Listings ===== -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" IsVisible="{Binding IsListingsSection}">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Padding="16,8">
                <Picker Grid.Column="0" Title="Sortuj"
                        ItemsSource="{Binding SortOptions}"
                        SelectedIndex="{Binding SelectedSortIndex}"
                        FontSize="13"/>
                <Picker Grid.Column="1" Title="Ocena AI"
                        ItemsSource="{Binding MinScoreOptions}"
                        SelectedIndex="{Binding SelectedMinScoreIndex}"
                        FontSize="13"/>
                <Label Grid.Column="2" VerticalOptions="Center" Style="{StaticResource HsMuted}"
                       Text="{Binding TotalListings, StringFormat='{0} ogł.'}"/>
            </Grid>

            <RefreshView Grid.Row="1"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding LoadListingsCommand}">
                <CollectionView ItemsSource="{Binding Listings}"
                                SelectionMode="None"
                                RemainingItemsThreshold="4"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreListingsCommand}"
                                Margin="16,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label Text="Brak ogłoszeń. Wyniki pojawią się po pierwszym skanie."
                               Style="{StaticResource HsMuted}"
                               HorizontalTextAlignment="Center"
                               Margin="24,40"/>
                    </CollectionView.EmptyView>
                    <CollectionView.Footer>
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                           IsVisible="{Binding IsLoadingMore}"
                                           Color="{StaticResource Primary}"
                                           Margin="0,12"/>
                    </CollectionView.Footer>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="hs:HomeSeekerListing">
                            <Border Style="{StaticResource HsCard}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeSeekerViewModel}}, Path=OpenListingCommand, x:DataType=vm:HomeSeekerViewModel}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <!-- Score badge -->
                                    <Border Grid.RowSpan="3" WidthRequest="52" HeightRequest="52"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 26"
                                            VerticalOptions="Start"
                                            BackgroundColor="{StaticResource Primary}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEvaluated}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Gray400}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding ScoreText}" TextColor="White" FontAttributes="Bold" FontSize="18"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <Label Grid.Column="1" Grid.Row="0" Text="{Binding Title}" Style="{StaticResource HsText}"
                                           FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation"/>

                                    <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="10">
                                        <Label Text="{Binding Price, StringFormat='{0:N0} zł'}" Style="{StaticResource HsText}"
                                               FontAttributes="Bold" TextColor="{StaticResource GreenColor}"/>
                                        <Label Text="{Binding AreaSqm, StringFormat='{0:0.#} m²'}" Style="{StaticResource HsText}"/>
                                        <Label Text="{Binding PricePerSqm, StringFormat='{0:N0} zł/m²'}" Style="{StaticResource HsMuted}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Grid.Row="2" Spacing="8">
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                                            <Label Text="{Binding Portal}" FontSize="11" Style="{StaticResource HsText}"/>
                                        </Border>
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2"
                                                BackgroundColor="{StaticResource PinkColor}"
                                                IsVisible="{Binding HasPriceDrop}">
                                            <Label Text="{Binding PreviousPrice, StringFormat='obniżka (było {0:N0} zł)'}" FontSize="11" TextColor="White"/>
                                        </Border>
                                        <Label Text="{Binding Location}" Style="{StaticResource HsMuted}" VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"/>
                                    </HorizontalStackLayout>

                                    <VerticalStackLayout Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Spacing="6" Margin="0,10,0,0"
                                                         IsVisible="{Binding IsEvaluated}">
                                        <Label Text="{Binding AiSummary}" Style="{StaticResource HsText}" FontSize="13"/>
                                        <Label Text="{Binding ProsText}" FontSize="12" TextColor="{StaticResource GreenColor}"
                                               IsVisible="{Binding ProsText, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                                        <Label Text="{Binding ConsText}" FontSize="12" TextColor="{StaticResource PinkColor}"
                                               IsVisible="{Binding ConsText, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                                        <Label Text="{Binding AiPriceAssessment, StringFormat='Cena: {0}'}" Style="{StaticResource HsMuted}"
                                               IsVisible="{Binding AiPriceAssessment, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" Margin="0,8,0,0"
                                           Style="{StaticResource HsMuted}" FontSize="11"
                                           Text="{Binding FirstSeenAtLocal, StringFormat='Pierwszy raz: {0:dd.MM.yyyy}'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- ===== Scans ===== -->
        <RefreshView Grid.Row="3"
                     IsVisible="{Binding IsScansSection}"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshScansCommand}">
            <CollectionView ItemsSource="{Binding Scans}" SelectionMode="None" Margin="16,8">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Text="Brak historii skanów."
                           Style="{StaticResource HsMuted}"
                           HorizontalTextAlignment="Center"
                           Margin="24,40"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="hs:HomeSeekerScanRun">
                        <Border Style="{StaticResource HsCard}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Label Text="{Binding StartedAtLocal, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                       Style="{StaticResource HsText}" FontAttributes="Bold"/>
                                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,2"
                                        BackgroundColor="{StaticResource GreenColor}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource PinkColor}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding StatusText}" FontSize="11" TextColor="White"/>
                                </Border>
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource HsMuted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Znalezione: "/>
                                            <Span Text="{Binding ListingsFoundCount}"/>
                                            <Span Text="  •  nowe: "/>
                                            <Span Text="{Binding NewListingsCount}"/>
                                            <Span Text="  •  obniżki: "/>
                                            <Span Text="{Binding PriceDropsCount}"/>
                                            <Span Text="  •  ocenione: "/>
                                            <Span Text="{Binding EvaluatedCount}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Row="2" Text="{Binding Error}" FontSize="12" TextColor="{StaticResource PinkColor}"
                                       IsVisible="{Binding Error, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                                <Button Grid.Row="2" Grid.Column="1" Text="Raport" FontSize="12" Padding="10,4"
                                        CornerRadius="8" HeightRequest="32"
                                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                                        IsVisible="{Binding HasReport}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeSeekerViewModel}}, Path=ShowReportCommand, x:DataType=vm:HomeSeekerViewModel}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- ===== Profile ===== -->
        <ScrollView Grid.Row="3" IsVisible="{Binding IsProfileSection}">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="16">
                <Border Style="{StaticResource HsCard}" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Wspólny profil wyszukiwania" Style="{StaticResource HsText}" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Profil jest współdzielony przez domowników. Skan uruchamia się cyklicznie na serwerze."
                               Style="{StaticResource HsMuted}"/>

                        <material:TextField Title="Miasto *" Text="{Binding City}" AllowClear="True" MaxLength="100"
                                            AccentColor="{StaticResource Primary}"/>
                        <material:TextField Title="Dzielnica" Text="{Binding District}" AllowClear="True" MaxLength="100"
                                            AccentColor="{StaticResource Primary}"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <material:TextField Grid.Column="0" Title="Cena min (zł)" Text="{Binding MinPrice}" Keyboard="Numeric"
                                                AccentColor="{StaticResource Primary}"/>
                            <material:TextField Grid.Column="1" Title="Cena max (zł)" Text="{Binding MaxPrice}" Keyboard="Numeric"
                                                AccentColor="{StaticResource Primary}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <material:TextField Grid.Column="0" Title="Metraż min (m²)" Text="{Binding MinArea}" Keyboard="Numeric"
                                                AccentColor="{StaticResource Primary}"/>
                            <material:TextField Grid.Column="1" Title="Metraż max (m²)" Text="{Binding MaxArea}" Keyboard="Numeric"
                                                AccentColor="{StaticResource Primary}"/>
                        </Grid>

                        <material:EditorField Title="Dodatkowe kryteria (dla AI)" Text="{Binding ExtraCriteria}"
                                              MinimumHeightRequest="100"
                                              AccentColor="{StaticResource Primary}"/>

                        <material:TextField Title="E-mail(e) do raportów * (rozdziel , lub ;)" Text="{Binding NotificationEmail}"
                                            Keyboard="Email" AllowClear="True"
                                            AccentColor="{StaticResource Primary}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Skanowanie aktywne" Style="{StaticResource HsText}"/>
                                <Label Text="Wyłącz, aby wstrzymać cykliczne skany" Style="{StaticResource HsMuted}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding IsActive}" OnColor="{StaticResource Primary}"/>
                        </Grid>

                        <Label Text="{Binding ValidationErrors}" IsVisible="{Binding HasValidationErrors}"
                               TextColor="{StaticResource PinkColor}" FontSize="13"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Zapisz profil"
                        Command="{Binding SaveProfileCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{StaticResource GreenColor}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Save}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="{StaticResource White}"
                                         Size="20"/>
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
