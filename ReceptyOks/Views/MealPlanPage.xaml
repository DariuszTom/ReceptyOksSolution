<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
   xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
          xmlns:data="clr-namespace:ReceptyOks.Data"
 xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
           x:Class="ReceptyOks.Views.MealPlanPage"
      x:DataType="vm:MealPlanViewModel"
      Shell.NavBarIsVisible="False"
        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#121212}">

    <Grid RowDefinitions="Auto,Auto,*">
      
        <!-- Custom Header -->
        <Grid Grid.Row="0" 
         Padding="20,16"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
      <Grid.Shadow>
    <Shadow Brush="{StaticResource Gray400Brush}" Offset="0,2" Radius="4" Opacity="0.1"/>
   </Grid.Shadow>
     <VerticalStackLayout VerticalOptions="Center">
            <Label Text="Plan Menu" 
 Style="{StaticResource PageTitle}"
       FontSize="24"/>
        <Label Text="Zaplanuj posiłki na tydzień" 
  Style="{StaticResource CaptionLabel}"/>
         </VerticalStackLayout>
   </Grid>

 <!-- Week Navigation -->
        <Border Grid.Row="1"
      Margin="16,12"
    StrokeThickness="0"
    StrokeShape="RoundRectangle 16"
          Padding="16"
        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
   <Button Grid.Column="0"
        WidthRequest="44"
         HeightRequest="44"
            Padding="0"
       BackgroundColor="{StaticResource Gray200}"
      CornerRadius="22"
    Command="{Binding PreviousWeekCommand}">
        <Button.ImageSource>
         <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Chevron_left}"
      FontFamily="MaterialSymbolsOutlined"
     Color="{StaticResource Gray700}"
          Size="24"/>
     </Button.ImageSource>
    </Button>
       
              <VerticalStackLayout Grid.Column="1" 
    HorizontalOptions="Center"
   VerticalOptions="Center">
            <Label Text="{Binding WeekRangeText}" 
 FontSize="18" 
          FontAttributes="Bold"
 HorizontalOptions="Center"
       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
        <Label Text="Dotknij aby wrócić do dziś"
             FontSize="12"
              HorizontalOptions="Center"
  TextColor="{StaticResource Gray500}">
    <Label.GestureRecognizers>
     <TapGestureRecognizer Command="{Binding GoToTodayCommand}"/>
           </Label.GestureRecognizers>
        </Label>
                </VerticalStackLayout>
          
    <Button Grid.Column="2"
             WidthRequest="44"
       HeightRequest="44"
     Padding="0"
            BackgroundColor="{StaticResource Gray200}"
          CornerRadius="22"
     Command="{Binding NextWeekCommand}">
 <Button.ImageSource>
            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Chevron_right}"
      FontFamily="MaterialSymbolsOutlined"
                 Color="{StaticResource Gray700}"
                  Size="24"/>
      </Button.ImageSource>
              </Button>
            </Grid>
</Border>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2"
      IsRunning="{Binding IsLoading}"
       IsVisible="{Binding IsLoading}"
      HeightRequest="50"
   WidthRequest="50"
            Color="{StaticResource Primary}"
   HorizontalOptions="Center"
         VerticalOptions="Center"/>

 <!-- Week Timeline -->
  <ScrollView Grid.Row="2" 
     IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
         <VerticalStackLayout Spacing="12" Padding="16,0,16,16">
                <CollectionView ItemsSource="{Binding WeekDays}"
         SelectionMode="None">
 <CollectionView.ItemTemplate>
         <DataTemplate x:DataType="vm:DayPlanItem">
             <Border Margin="0,6"
         StrokeThickness="0"
        StrokeShape="RoundRectangle 16"
           Padding="16"
 BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
        <Border.Triggers>
   <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
              <Setter Property="Stroke" Value="{StaticResource Primary}"/>
    <Setter Property="StrokeThickness" Value="2"/>
         </DataTrigger>
             </Border.Triggers>
            <VerticalStackLayout Spacing="12">
             <!-- Day Header -->
       <Grid ColumnDefinitions="*,Auto">
    <VerticalStackLayout>
  <Label Text="{Binding DayName}" 
           FontSize="18" 
         FontAttributes="Bold"
           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            <Label Text="{Binding DateText}" 
  FontSize="14" 
         TextColor="{StaticResource Gray500}"/>
      </VerticalStackLayout>
         <Border Grid.Column="1"
     IsVisible="{Binding IsToday}"
    Padding="10,4"
           StrokeThickness="0"
           StrokeShape="RoundRectangle 12"
      BackgroundColor="{StaticResource Primary}">
    <Label Text="DZIŚ" 
     FontSize="11" 
       FontAttributes="Bold"
             TextColor="White"/>
  </Border>
  </Grid>

   <!-- Breakfast Section -->
           <VerticalStackLayout Spacing="8">
       <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
   <Image HeightRequest="20" WidthRequest="20">
               <Image.Source>
      <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Egg_alt}"
          FontFamily="MaterialSymbolsOutlined"
    Color="#FF9800"
 Size="20"/>
   </Image.Source>
               </Image>
          <Label Grid.Column="1" 
        Text="Śniadanie" 
   FontSize="14"
        FontAttributes="Bold"
                VerticalOptions="Center"
  TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
          <ImageButton Grid.Column="2"
      HeightRequest="28"
       WidthRequest="28"
      Padding="4"
     BackgroundColor="{StaticResource Primary}"
          CornerRadius="14"
         Clicked="OnAddBreakfastClicked"
  BindingContext="{Binding}">
          <ImageButton.Source>
           <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add}"
         FontFamily="MaterialSymbolsOutlined"
    Color="White"
  Size="16"/>
  </ImageButton.Source>
      </ImageButton>
     </Grid>
        <BindableLayout.ItemsSource>
  <x:Null/>
 </BindableLayout.ItemsSource>
       <CollectionView ItemsSource="{Binding BreakfastMeals}"
       SelectionMode="None"
      HeightRequest="{Binding BreakfastMeals.Count, Converter={StaticResource MealCountToHeightConverter}}">
  <CollectionView.ItemTemplate>
   <DataTemplate x:DataType="vm:MealItem">
    <Border Margin="0,2"
       Padding="12,8"
  StrokeThickness="0"
           StrokeShape="RoundRectangle 10"
        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
               <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
     <Label Text="{Binding Recipe.Title}" 
          FontSize="14"
         VerticalOptions="Center"
   LineBreakMode="TailTruncation"
         TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
     <Label.GestureRecognizers>
                   <TapGestureRecognizer 
             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=GoToRecipeDetailCommand}"
      CommandParameter="{Binding}"/>
          </Label.GestureRecognizers>
    </Label>
                <ImageButton Grid.Column="1"
          HeightRequest="24"
 WidthRequest="24"
             Padding="2"
             BackgroundColor="Transparent"
       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=RemoveMealCommand}"
               CommandParameter="{Binding}">
         <ImageButton.Source>
           <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
     FontFamily="MaterialSymbolsOutlined"
   Color="{StaticResource Gray400}"
      Size="18"/>
       </ImageButton.Source>
            </ImageButton>
     </Grid>
  </Border>
                </DataTemplate>
 </CollectionView.ItemTemplate>
   </CollectionView>
     </VerticalStackLayout>

     <!-- Lunch Section -->
        <VerticalStackLayout Spacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <Image HeightRequest="20" WidthRequest="20">
     <Image.Source>
       <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Restaurant}"
 FontFamily="MaterialSymbolsOutlined"
          Color="#4CAF50"
    Size="20"/>
  </Image.Source>
           </Image>
       <Label Grid.Column="1" 
      Text="Obiad" 
        FontSize="14"
   FontAttributes="Bold"
             VerticalOptions="Center"
          TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
         <ImageButton Grid.Column="2"
     HeightRequest="28"
       WidthRequest="28"
   Padding="4"
           BackgroundColor="{StaticResource Primary}"
        CornerRadius="14"
           Clicked="OnAddLunchClicked"
      BindingContext="{Binding}">
    <ImageButton.Source>
  <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add}"
        FontFamily="MaterialSymbolsOutlined"
       Color="White"
   Size="16"/>
         </ImageButton.Source>
       </ImageButton>
           </Grid>
     <CollectionView ItemsSource="{Binding LunchMeals}"
           SelectionMode="None"
           HeightRequest="{Binding LunchMeals.Count, Converter={StaticResource MealCountToHeightConverter}}">
          <CollectionView.ItemTemplate>
                  <DataTemplate x:DataType="vm:MealItem">
 <Border Margin="0,2"
        Padding="12,8"
     StrokeThickness="0"
   StrokeShape="RoundRectangle 10"
       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
           <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
             <Label Text="{Binding Recipe.Title}" 
       FontSize="14"
         VerticalOptions="Center"
             LineBreakMode="TailTruncation"
           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
     <Label.GestureRecognizers>
          <TapGestureRecognizer 
                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=GoToRecipeDetailCommand}"
  CommandParameter="{Binding}"/>
        </Label.GestureRecognizers>
  </Label>
    <ImageButton Grid.Column="1"
              HeightRequest="24"
      WidthRequest="24"
                Padding="2"
      BackgroundColor="Transparent"
             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=RemoveMealCommand}"
 CommandParameter="{Binding}">
           <ImageButton.Source>
 <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
        FontFamily="MaterialSymbolsOutlined"
     Color="{StaticResource Gray400}"
   Size="18"/>
             </ImageButton.Source>
 </ImageButton>
            </Grid>
  </Border>
      </DataTemplate>
     </CollectionView.ItemTemplate>
      </CollectionView>
       </VerticalStackLayout>

        <!-- Dinner Section -->
    <VerticalStackLayout Spacing="8">
       <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
       <Image HeightRequest="20" WidthRequest="20">
         <Image.Source>
       <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Dinner_dining}"
         FontFamily="MaterialSymbolsOutlined"
          Color="#9C27B0"
 Size="20"/>
                 </Image.Source>
        </Image>
   <Label Grid.Column="1" 
  Text="Kolacja" 
   FontSize="14"
        FontAttributes="Bold"
    VerticalOptions="Center"
TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
  <ImageButton Grid.Column="2"
    HeightRequest="28"
  WidthRequest="28"
        Padding="4"
        BackgroundColor="{StaticResource Primary}"
              CornerRadius="14"
    Clicked="OnAddDinnerClicked"
 BindingContext="{Binding}">
          <ImageButton.Source>
  <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add}"
       FontFamily="MaterialSymbolsOutlined"
                 Color="White"
      Size="16"/>
          </ImageButton.Source>
             </ImageButton>
    </Grid>
      <CollectionView ItemsSource="{Binding DinnerMeals}"
     SelectionMode="None"
              HeightRequest="{Binding DinnerMeals.Count, Converter={StaticResource MealCountToHeightConverter}}">
   <CollectionView.ItemTemplate>
   <DataTemplate x:DataType="vm:MealItem">
    <Border Margin="0,2"
Padding="12,8"
  StrokeThickness="0"
  StrokeShape="RoundRectangle 10"
       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
   <Label Text="{Binding Recipe.Title}" 
           FontSize="14"
           VerticalOptions="Center"
           LineBreakMode="TailTruncation"
              TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
      <Label.GestureRecognizers>
      <TapGestureRecognizer 
             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=GoToRecipeDetailCommand}"
               CommandParameter="{Binding}"/>
      </Label.GestureRecognizers>
        </Label>
          <ImageButton Grid.Column="1"
               HeightRequest="24"
  WidthRequest="24"
       Padding="2"
         BackgroundColor="Transparent"
     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=RemoveMealCommand}"
         CommandParameter="{Binding}">
      <ImageButton.Source>
           <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
           FontFamily="MaterialSymbolsOutlined"
      Color="{StaticResource Gray400}"
            Size="18"/>
        </ImageButton.Source>
    </ImageButton>
             </Grid>
        </Border>
           </DataTemplate>
       </CollectionView.ItemTemplate>
         </CollectionView>
    </VerticalStackLayout>
           </VerticalStackLayout>
             </Border>
     </DataTemplate>
            </CollectionView.ItemTemplate>
    </CollectionView>
  </VerticalStackLayout>
    </ScrollView>

   <!-- Recipe Picker Overlay -->
        <Grid Grid.RowSpan="3"
         IsVisible="{Binding IsRecipePickerVisible}"
              BackgroundColor="#80000000">
 <Grid.GestureRecognizers>
     <TapGestureRecognizer Command="{Binding CloseRecipePickerCommand}"/>
   </Grid.GestureRecognizers>
  
     <Border VerticalOptions="Center"
                    HorizontalOptions="Fill"
 Margin="20"
    StrokeThickness="0"
              StrokeShape="RoundRectangle 20"
     BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
          MaximumHeightRequest="500">
                <Border.GestureRecognizers>
      <TapGestureRecognizer/>
</Border.GestureRecognizers>
  <VerticalStackLayout Spacing="16" Padding="20">
         <Grid ColumnDefinitions="*,Auto">
       <Label Text="Wybierz przepis" 
      FontSize="20" 
          FontAttributes="Bold"
          VerticalOptions="Center"
        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
  <ImageButton Grid.Column="1"
   HeightRequest="32"
            WidthRequest="32"
     BackgroundColor="Transparent"
        Command="{Binding CloseRecipePickerCommand}">
           <ImageButton.Source>
    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
 FontFamily="MaterialSymbolsOutlined"
          Color="{StaticResource Gray400}"
            Size="24"/>
       </ImageButton.Source>
    </ImageButton>
      </Grid>
                    
         <!-- Search -->
            <Border StrokeThickness="1"
            Stroke="{StaticResource Gray300}"
   StrokeShape="RoundRectangle 12"
     Padding="12,8">
           <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
     <Image HeightRequest="20" WidthRequest="20">
           <Image.Source>
     <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Search}"
            FontFamily="MaterialSymbolsOutlined"
               Color="{StaticResource Gray400}"
            Size="20"/>
       </Image.Source>
       </Image>
           <Entry Grid.Column="1"
        Placeholder="Szukaj przepisu..."
    Text="{Binding RecipeSearchQuery}"
FontSize="15"/>
                  </Grid>
         </Border>
      
        <!-- Recipe List -->
        <CollectionView ItemsSource="{Binding FilteredRecipes}"
       HeightRequest="300"
   SelectionMode="None">
         <CollectionView.ItemTemplate>
 <DataTemplate x:DataType="data:RecipeLocal">
     <Border Margin="0,4"
      Padding="14,12"
 StrokeThickness="0"
 StrokeShape="RoundRectangle 12"
      BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
    <Border.GestureRecognizers>
               <TapGestureRecognizer 
            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=SelectRecipeCommand}"
              CommandParameter="{Binding}"/>
              </Border.GestureRecognizers>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
   <VerticalStackLayout>
      <Label Text="{Binding Title}" 
           FontSize="15"
     FontAttributes="Bold"
     LineBreakMode="TailTruncation"
    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
     <Label FontSize="12" TextColor="{StaticResource Gray500}">
             <Label.FormattedText>
    <FormattedString>
          <Span Text="{Binding PreparationTimeMinutes}"/>
        <Span Text=" + "/>
          <Span Text="{Binding CookingTimeMinutes}"/>
             <Span Text=" min"/>
           </FormattedString>
 </Label.FormattedText>
          </Label>
              </VerticalStackLayout>
  <Image Grid.Column="1" HeightRequest="20" WidthRequest="20">
           <Image.Source>
            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add_circle}"
       FontFamily="MaterialSymbolsOutlined"
        Color="{StaticResource Primary}"
    Size="20"/>
          </Image.Source>
     </Image>
      </Grid>
        </Border>
   </DataTemplate>
 </CollectionView.ItemTemplate>
    <CollectionView.EmptyView>
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
         <Label Text="Brak przepisów" 
            FontSize="16"
          TextColor="{StaticResource Gray500}"
         HorizontalOptions="Center"/>
     <Label Text="Dodaj przepisy w zakładce Przepisy"
         FontSize="13"
        TextColor="{StaticResource Gray400}"
     HorizontalOptions="Center"/>
     </VerticalStackLayout>
        </CollectionView.EmptyView>
       </CollectionView>
        </VerticalStackLayout>
       </Border>
        </Grid>
    </Grid>
</ContentPage>
