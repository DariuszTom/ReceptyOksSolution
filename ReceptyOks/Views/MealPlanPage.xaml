<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
             xmlns:data="clr-namespace:ReceptyOks.Data"
             xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="ReceptyOks.Views.MealPlanPage"
             x:DataType="vm:MealPlanViewModel"
             Shell.NavBarIsVisible="False"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BlackBrownPurpleGradient}}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Custom Header -->
        <Grid Grid.Row="0"
              Padding="20,16"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <Grid.Shadow>
                <Shadow Brush="{StaticResource Gray400Brush}"
                        Offset="0,2"
                        Radius="4"
                        Opacity="0.1" />
            </Grid.Shadow>
            <HorizontalStackLayout VerticalOptions="Center"
                                   Spacing="12">
                <Image HeightRequest="28"
                       WidthRequest="28"
                       VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Calendar_month}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="{StaticResource Primary}"
                                         Size="28" />
                    </Image.Source>
                </Image>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Plan Menu"
                           Style="{StaticResource PageTitle}"
                           FontSize="24" />
                    <Label Text="Zaplanuj posiłki na tydzień"
                           Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="10"
                                   VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsGeneratingShoppingList}"
                                   IsVisible="{Binding IsGeneratingShoppingList}"
                                   Color="{StaticResource Primary}"
                                   HeightRequest="28"
                                   WidthRequest="28"
                                   VerticalOptions="Center" />
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,8"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource Primary}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GenerateShoppingListCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6"
                                           VerticalOptions="Center">
                        <Image HeightRequest="18"
                               WidthRequest="18">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Shopping_cart}"
                                                 FontFamily="MaterialSymbolsOutlined"
                                                 Color="White"
                                                 Size="18" />
                            </Image.Source>
                        </Image>
                        <Label Text="Lista zakupów"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsGeneratingShoppingList}"
                                             Value="True">
                                    <Setter Property="Text" Value="Generuję..." />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Image Source="export.png"
                               HeightRequest="18"
                               WidthRequest="18"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- Week Navigation -->
        <Border Grid.Row="1"
                Margin="16,12"
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <Button Grid.Column="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        BackgroundColor="{StaticResource Gray200}"
                        CornerRadius="22"
                        Command="{Binding PreviousWeekCommand}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Chevron_left}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="{StaticResource Gray700}"
                                         Size="24" />
                    </Button.ImageSource>
                </Button>

                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="{Binding WeekRangeText}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Label Text="Dotknij aby wrócić do dziś"
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Gray500}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToTodayCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        BackgroundColor="{StaticResource Gray200}"
                        CornerRadius="22"
                        Command="{Binding NextWeekCommand}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Chevron_right}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="{StaticResource Gray700}"
                                         Size="24" />
                    </Button.ImageSource>
                </Button>

            </Grid>
        </Border>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HeightRequest="50"
                           WidthRequest="50"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Week Timeline -->
        <ScrollView Grid.Row="2"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16,0,16,16">

                <Border Margin="0,6"
                        Padding="16"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

                    <VerticalStackLayout Spacing="8">

                        <!-- Week Header -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="8">
                            <Image HeightRequest="28"
                                   WidthRequest="28"
                                   VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Date_range}"
                                                     FontFamily="MaterialSymbolsOutlined"
                                                     Color="{StaticResource Primary}"
                                                     Size="28" />
                                </Image.Source>
                            </Image>
                            <Label Grid.Column="1"
                                   Text="{Binding WeekRangeText}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        </Grid>

                        <!-- Meal count + expand toggle -->
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="0,4">
                            <Label Text="{Binding WeekMealCountText}"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray500}"
                                   VerticalOptions="Center" />
                            <ImageButton Grid.Column="1"
                                         HeightRequest="32"
                                         WidthRequest="32"
                                         Padding="4"
                                         BackgroundColor="Transparent"
                                         VerticalOptions="Center"
                                         Clicked="OnToggleWeekTimelineClicked">
                                <ImageButton.Triggers>
                                    <DataTrigger TargetType="ImageButton"
                                                 Binding="{Binding IsWeekExpanded}"
                                                 Value="False">
                                        <Setter Property="Source">
                                            <Setter.Value>
                                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Expand_more}"
                                                                 FontFamily="MaterialSymbolsOutlined"
                                                                 Color="{StaticResource Gray400}"
                                                                 Size="24" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger TargetType="ImageButton"
                                                 Binding="{Binding IsWeekExpanded}"
                                                 Value="True">
                                        <Setter Property="Source">
                                            <Setter.Value>
                                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Expand_less}"
                                                                 FontFamily="MaterialSymbolsOutlined"
                                                                 Color="{StaticResource Gray400}"
                                                                 Size="24" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </ImageButton.Triggers>
                            </ImageButton>
                        </Grid>

                        <!-- Date Slots Timeline -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DateSlots}"
                                             IsVisible="{Binding IsWeekExpanded}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DateSlot">
                                    <Grid ColumnDefinitions="90,*"
                                          MinimumHeightRequest="56"
                                          Padding="0,2">

                                        <!-- Date label -->
                                        <VerticalStackLayout VerticalOptions="Center"
                                                             HorizontalOptions="End"
                                                             Margin="0,0,10,0">
                                            <Label Text="{Binding Label}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Gray400}"
                                                   HorizontalTextAlignment="End" />
                                            <Border IsVisible="{Binding IsToday}"
                                                    Padding="6,2"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    HorizontalOptions="End">
                                                <Label Text="DZIŚ"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <!-- Empty slot (tappable) -->
                                        <Border Grid.Column="1"
                                                StrokeThickness="0.5"
                                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                StrokeShape="RoundRectangle 4"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                IsVisible="{Binding IsOccupied, Converter={StaticResource InvertedBoolConverter}}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDateSlotTapped" />
                                            </Border.GestureRecognizers>
                                        </Border>

                                        <!-- Occupied slot (meal chips) -->
                                        <Border Grid.Column="1"
                                                StrokeThickness="0.5"
                                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="Transparent"
                                                Padding="4"
                                                IsVisible="{Binding IsOccupied}">
                                            <VerticalStackLayout Spacing="4">

                                                <!-- Meal chips (wrapping) -->
                                                <FlexLayout BindableLayout.ItemsSource="{Binding Meals}"
                                                            Wrap="Wrap"
                                                            Direction="Row"
                                                            AlignItems="Center">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MealItem">
                                                            <Border Margin="2"
                                                                    Padding="10,6"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 14"
                                                                    BackgroundColor="{StaticResource Primary}">
                                                                <HorizontalStackLayout Spacing="6"
                                                                                   VerticalOptions="Center">
                                                                    <VerticalStackLayout VerticalOptions="Center"
                                                                                         MaximumWidthRequest="180">
                                                                        <VerticalStackLayout.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="OnMealChipTapped" />
                                                                        </VerticalStackLayout.GestureRecognizers>
                                                                        <Label Text="{Binding Recipe.Title}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="White"
                                                                               LineBreakMode="TailTruncation" />
                                                                        <Label Text="{Binding CategoryName}"
                                                                               FontSize="9"
                                                                               TextColor="#AAFFFFFF"
                                                                               LineBreakMode="TailTruncation"
                                                                               IsVisible="{Binding CategoryName, Converter={StaticResource IsNotNullConverter}}" />
                                                                    </VerticalStackLayout>
                                                                    <ImageButton HeightRequest="18"
                                                                                 WidthRequest="18"
                                                                                 Padding="2"
                                                                                 BackgroundColor="Transparent"
                                                                                 VerticalOptions="Center"
                                                                                 Clicked="OnRemoveChipClicked">
                                                                        <ImageButton.Source>
                                                                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
                                                                                             FontFamily="MaterialSymbolsOutlined"
                                                                                             Color="#BBFFFFFF"
                                                                                             Size="12" />
                                                                        </ImageButton.Source>
                                                                    </ImageButton>
                                                                </HorizontalStackLayout>
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </FlexLayout>

                                                <!-- Add meal chip -->
                                                <Border Padding="8,5"
                                                        StrokeThickness="1"
                                                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                                        StrokeShape="RoundRectangle 14"
                                                        BackgroundColor="Transparent"
                                                        HorizontalOptions="Start"
                                                        Margin="2,0">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnAddToDateSlotTapped" />
                                                    </Border.GestureRecognizers>
                                                    <HorizontalStackLayout Spacing="4"
                                                                           VerticalOptions="Center">
                                                        <Image HeightRequest="14"
                                                               WidthRequest="14"
                                                               VerticalOptions="Center">
                                                            <Image.Source>
                                                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add}"
                                                                                 FontFamily="MaterialSymbolsOutlined"
                                                                                 Color="{StaticResource Primary}"
                                                                                 Size="14" />
                                                            </Image.Source>
                                                        </Image>
                                                        <Label Text="Dodaj"
                                                               FontSize="11"
                                                               TextColor="{StaticResource Primary}"
                                                               VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Border>

                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Recipe Picker Overlay -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsRecipePickerVisible}"
              BackgroundColor="#80000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseRecipePickerCommand}" />
            </Grid.GestureRecognizers>

            <Border VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    Margin="20"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                    MaximumHeightRequest="550">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid>

                    <!-- Step 1: Category Selection -->
                    <VerticalStackLayout Spacing="16"
                                         Padding="20"
                                         IsVisible="{Binding IsCategoryStepVisible}">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Wybierz kategorię"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                <Label Text="{Binding SelectedTimeSlotText}"
                                       FontSize="13"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <ImageButton Grid.Column="1"
                                         HeightRequest="32"
                                         WidthRequest="32"
                                         BackgroundColor="Transparent"
                                         Command="{Binding CloseRecipePickerCommand}">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
                                                     FontFamily="MaterialSymbolsOutlined"
                                                     Color="{StaticResource Gray400}"
                                                     Size="24" />
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>

                        <CollectionView ItemsSource="{Binding AvailableCategories}"
                                        HeightRequest="350"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical"
                                                 Span="2"
                                                 HorizontalItemSpacing="10"
                                                 VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="data:CategoryLocal">
                                    <Border Padding="16,20"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{StaticResource Primary}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=SelectCategoryCommand}"
                                                                  CommandParameter="{Binding}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="4"
                                                             VerticalOptions="Center"
                                                             HorizontalOptions="Start">
                                            <Image Source="{Binding IconName}"
                                                   HeightRequest="40"
                                                   WidthRequest="40"
                                                   Aspect="AspectFit"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Description}"
                                                   FontSize="11"
                                                   TextColor="#CCFFFFFF"
                                                   HorizontalOptions="Center"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <VerticalStackLayout VerticalOptions="Center"
                                                     HorizontalOptions="Center"
                                                     Padding="20">
                                    <Label Text="Brak kategorii"
                                           FontSize="16"
                                           TextColor="{StaticResource Gray500}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>

                    </VerticalStackLayout>

                    <!-- Step 2: Recipe Selection -->
                    <VerticalStackLayout Spacing="16"
                                         Padding="20"
                                         IsVisible="{Binding IsRecipeStepVisible}">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="8">
                            <ImageButton HeightRequest="32"
                                         WidthRequest="32"
                                         BackgroundColor="Transparent"
                                         Command="{Binding BackToCategoriesCommand}">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Arrow_back}"
                                                     FontFamily="MaterialSymbolsOutlined"
                                                     Color="{StaticResource Gray400}"
                                                     Size="24" />
                                </ImageButton.Source>
                            </ImageButton>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding SelectedCategory.Name}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                <Label Text="{Binding SelectedTimeSlotText}"
                                       FontSize="12"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <ImageButton Grid.Column="2"
                                         HeightRequest="32"
                                         WidthRequest="32"
                                         BackgroundColor="Transparent"
                                         Command="{Binding CloseRecipePickerCommand}">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
                                                     FontFamily="MaterialSymbolsOutlined"
                                                     Color="{StaticResource Gray400}"
                                                     Size="24" />
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>

                        <!-- Search -->
                        <Border StrokeThickness="1"
                                Stroke="{StaticResource Gray300}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">
                                <Image HeightRequest="20"
                                       WidthRequest="20">
                                    <Image.Source>
                                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Search}"
                                                         FontFamily="MaterialSymbolsOutlined"
                                                         Color="{StaticResource Gray400}"
                                                         Size="20" />
                                    </Image.Source>
                                </Image>
                                <Entry Grid.Column="1"
                                       Placeholder="Szukaj przepisu..."
                                       Text="{Binding RecipeSearchQuery}"
                                       FontSize="15" />
                            </Grid>
                        </Border>

                        <!-- Recipe List -->
                        <CollectionView ItemsSource="{Binding FilteredRecipes}"
                                        HeightRequest="280"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="data:RecipeLocal">
                                    <Border Margin="0,4"
                                            Padding="14,12"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=SelectRecipeCommand}"
                                                                  CommandParameter="{Binding}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                                <Label FontSize="12"
                                                       TextColor="{StaticResource Gray500}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding PreparationTimeMinutes}" />
                                                            <Span Text=" + " />
                                                            <Span Text="{Binding CookingTimeMinutes}" />
                                                            <Span Text=" min" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Image Grid.Column="1"
                                                   HeightRequest="20"
                                                   WidthRequest="20">
                                                <Image.Source>
                                                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add_circle}"
                                                                     FontFamily="MaterialSymbolsOutlined"
                                                                     Color="{StaticResource Primary}"
                                                                     Size="20" />
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <VerticalStackLayout VerticalOptions="Center"
                                                     HorizontalOptions="Center"
                                                     Padding="20">
                                    <Label Text="Brak przepisów w tej kategorii"
                                           FontSize="16"
                                           TextColor="{StaticResource Gray500}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>

                    </VerticalStackLayout>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
