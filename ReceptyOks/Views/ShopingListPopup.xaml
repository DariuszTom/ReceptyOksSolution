<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             x:Class="ReceptyOks.Views.ShopingListPopup"
             x:Name="thisPopup"
             WidthRequest="320"
             MaximumHeightRequest="480"
             Padding="0"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="0">

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="4"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="{StaticResource Primary}">
            <Image Grid.Column="0"
                   HeightRequest="22"
                   WidthRequest="22"
                   VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Shopping_cart}"
                                     FontFamily="MaterialSymbolsOutlined"
                                     Color="White"
                                     Size="22" />
                </Image.Source>
            </Image>
            <Label Grid.Column="1"
                   Text="Lista zakupów"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   Margin="5,0,0,0" />
            <ImageButton Grid.Column="2"
                         HeightRequest="30"
                         WidthRequest="30"
                         Padding="0"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center"
                         Clicked="OnCloseClicked">
                <ImageButton.Source>
                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
                                     FontFamily="MaterialSymbolsOutlined"
                                     Color="White"
                                     Size="22" />
                </ImageButton.Source>
            </ImageButton>
        </Grid>

        <!-- Shopping list content -->
        <ScrollView Grid.Row="1"
                    Padding="4"
                    MaximumHeightRequest="340">
            <Label x:Name="ShoppingListLabel"
                   Text="{Binding ShoppingListText, Source={x:Reference thisPopup}}"
                   FontSize="14"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}" />
        </ScrollView>

        <!-- Footer -->
        <HorizontalStackLayout Grid.Row="2"
                               Padding="14,8"
                               HorizontalOptions="End">
            <Button Text="Kopiuj"
                    FontSize="13"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="{StaticResource Primary}"
                    CornerRadius="10"
                    HeightRequest="38"
                    Padding="16,0"
                    Clicked="OnCopyClicked">
                <Button.ImageSource>
                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Content_copy}"
                                     FontFamily="MaterialSymbolsOutlined"
                                     Color="{StaticResource Primary}"
                                     Size="18" />
                </Button.ImageSource>
            </Button>
        </HorizontalStackLayout>

    </Grid>

</ContentView>
