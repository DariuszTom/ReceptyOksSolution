<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
          xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
     x:Class="ReceptyOks.Views.ChatBotPage"
    x:Name="ChatBotPageRoot"
   x:DataType="vm:ChatBotViewModel"
    Title="ChatBotPage"
    xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
      xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
   xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
   xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
        Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#121212}">

  <!-- Main content wrapper -->
    <Grid>
      <!-- Main chat content -->
        <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header with gradient effect -->
   <Grid Grid.Row="0" 
              Padding="24,20"
    ColumnDefinitions="*,Auto"
    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
   <Grid.Shadow>
           <Shadow Brush="{StaticResource Gray400Brush}" Offset="0,3" Radius="8" Opacity="0.12"/>
        </Grid.Shadow>
            
 <HorizontalStackLayout VerticalOptions="Center" Spacing="14">
        <!-- Avatar with border -->
                <Border StrokeThickness="2"
       Stroke="{StaticResource Primary}"
       StrokeShape="RoundRectangle 24"
       HeightRequest="48"
         WidthRequest="48"
          BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
          <Image Source="chatbot.png"
                HeightRequest="32"
        WidthRequest="32"
      HorizontalOptions="Center"
        VerticalOptions="Center"/>
  </Border>
                
      <VerticalStackLayout VerticalOptions="Center" Spacing="4">
            <Label Text="Asystent przepisów"
     FontSize="22"
              FontAttributes="Bold"
           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
      <HorizontalStackLayout Spacing="6">
      <Border StrokeThickness="0"
    BackgroundColor="#4CAF50"
            StrokeShape="RoundRectangle 6"
          HeightRequest="8"
       WidthRequest="8"
  VerticalOptions="Center"/>
 <Label Text="Gotowy do pomocy"
            FontSize="13"
          TextColor="{StaticResource Gray500}"/>
     </HorizontalStackLayout>
          </VerticalStackLayout>
         </HorizontalStackLayout>
       
<!-- Header Buttons -->
 <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
  <!-- Save conversation button -->
         <Border StrokeThickness="0"
       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
             StrokeShape="RoundRectangle 20"
            Padding="0">
             <Button Command="{Binding SaveConversationCommand}" 
     BackgroundColor="Transparent"
         WidthRequest="40"
        HeightRequest="40">
      <Button.ImageSource>
      <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Save}"
              FontFamily="MaterialSymbolsOutlined"
        Color="#2196F3"
       Size="22"/>
  </Button.ImageSource>
         </Button>
    </Border>

  <!-- History button -->
    <Border StrokeThickness="0"
           BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
           StrokeShape="RoundRectangle 20"
      Padding="0">
             <Button Command="{Binding OpenHistoryCommand}"
             BackgroundColor="Transparent"
             WidthRequest="40"
    HeightRequest="40">
       <Button.ImageSource>
          <FontImageSource Glyph="{x:Static icons:MaterialOutlined.History}"
           FontFamily="MaterialSymbolsOutlined"
   Color="{StaticResource Gray600}"
       Size="22"/>
      </Button.ImageSource>
           </Button>
       </Border>

   <!-- Clear conversation button -->
<Border StrokeThickness="0"
          BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
    StrokeShape="RoundRectangle 20"
        Padding="0">
             <Button Command="{Binding ClearConversationCommand}" 
             BackgroundColor="Transparent"
    WidthRequest="40"
    HeightRequest="40">
     <Button.ImageSource>
          <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Delete_sweep}"
   FontFamily="MaterialSymbolsOutlined"
   Color="#EF5350"
        Size="22"/>
      </Button.ImageSource>
      </Button>
        </Border>
  </HorizontalStackLayout>
        </Grid>

        <!-- Messages List -->
        <CollectionView Grid.Row="1"
                        x:Name="MessagesCollection"
                        ItemsSource="{Binding Messages}"
                        Margin="12,8"
                        BackgroundColor="Transparent"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" 
                                     HorizontalOptions="Center" 
                                     Spacing="16" 
                                     Padding="40">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 40"
                            HeightRequest="80"
                            WidthRequest="80"
                            HorizontalOptions="Center">
                        <Image HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Chat}"
                                                 FontFamily="MaterialSymbolsOutlined"
                                                 Color="{StaticResource Primary}"
                                                 Size="40"/>
                            </Image.Source>
                        </Image>
                    </Border>
                    <Label Text="Rozpocznij rozmowę" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center"/>
                    <Label Text="Zapytaj mnie o przepisy, składniki lub poproś o sugestie" 
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
     <CollectionView.ItemTemplate>
           <DataTemplate x:DataType="vm:ChatMessageViewModel">
       <Grid Padding="8,6">
         <!-- User message - right aligned with gradient -->
          <Border IsVisible="{Binding IsUser}"
      HorizontalOptions="End"
 MaximumWidthRequest="320"
  Padding="18,14"
     StrokeThickness="0"
 StrokeShape="RoundRectangle 24,24,4,24"
       BackgroundColor="{StaticResource Primary}">
      <Border.Shadow>
   <Shadow Brush="{StaticResource Primary}"
    Offset="0,4"
    Radius="12"
     Opacity="0.3"/>
                 </Border.Shadow>
            <Label Text="{Binding Content}"
            TextColor="White"
  FontSize="15"
           LineHeight="1.4"
         LineBreakMode="WordWrap"/>
         </Border>
        
  <!-- Assistant message - left aligned with avatar -->
              <HorizontalStackLayout IsVisible="{Binding IsAssistant}"
              HorizontalOptions="Start"
    Spacing="10">
    <!-- Avatar -->
     <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
             StrokeThickness="0"
  StrokeShape="RoundRectangle 20"
         HeightRequest="40"
      WidthRequest="40"
          VerticalOptions="End"
            Margin="0,0,0,0">
  <Image Source="chatbot.png"
        HeightRequest="24"
            WidthRequest="24"
       HorizontalOptions="Center"
    VerticalOptions="Center"/>
          </Border>
               
     <!-- Message bubble -->
       <Border MaximumWidthRequest="320"
    Padding="18,14"
      StrokeThickness="1"
      Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
     StrokeShape="RoundRectangle 24,24,24,4"
     BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}">
       <Border.Shadow>
     <Shadow Brush="{StaticResource Gray400Brush}"
              Offset="0,3"
   Radius="12"
     Opacity="0.15"/>
    </Border.Shadow>
        <Label Text="{Binding Content}"
            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
     FontSize="15"
       LineHeight="1.4"
    LineBreakMode="WordWrap"/>
  </Border>
                </HorizontalStackLayout>
              </Grid>
         </DataTemplate>
   </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Error message with icon -->
        <Border Grid.Row="1"
         IsVisible="{Binding HasError}"
        VerticalOptions="End"
     Margin="16,0,16,8"
 Padding="16,12"
      BackgroundColor="#FFEBEE"
      StrokeThickness="1"
       Stroke="#FFCDD2"
        StrokeShape="RoundRectangle 12">
            <Border.Shadow>
           <Shadow Brush="#EF5350" Offset="0,2" Radius="8" Opacity="0.2"/>
            </Border.Shadow>
          <HorizontalStackLayout Spacing="10">
                <Image HeightRequest="20" WidthRequest="20" VerticalOptions="Center">
       <Image.Source>
         <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Error}"
             FontFamily="MaterialSymbolsOutlined"
        Color="#C62828"
   Size="20"/>
   </Image.Source>
                </Image>
          <Label Text="{Binding ErrorMessage}"
       TextColor="#C62828"
            FontSize="14"
           VerticalOptions="Center"
       LineBreakMode="WordWrap"
    MaximumWidthRequest="300"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="2"
   Margin="16,8,16,16"
       Padding="12"
       StrokeThickness="2"
    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
     StrokeShape="RoundRectangle 32"
          BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <Border.Shadow>
<Shadow Brush="{StaticResource Gray400Brush}"
      Offset="0,-3"
   Radius="16"
          Opacity="0.12"/>
            </Border.Shadow>
     <Grid ColumnDefinitions="*,Auto,Auto">
          <!-- Text input -->
            <Editor Grid.Column="0"
         Text="{Binding UserInput}"
    Placeholder="Napisz wiadomość..."
           PlaceholderColor="{StaticResource Gray400}"
      FontSize="16"
    AutoSize="TextChanges"
  MaximumHeightRequest="120"
         Margin="16,8,8,8"
    BackgroundColor="Transparent"
  TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                
  <!-- Cancel button (visible when busy) -->
                <Border Grid.Column="1"
             IsVisible="{Binding IsBusy}"
       WidthRequest="48"
         HeightRequest="48"
     VerticalOptions="End"
                Margin="4"
        StrokeThickness="0"
          BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
           StrokeShape="RoundRectangle 24">
   <Button Command="{Binding CancelCommand}"
    BackgroundColor="Transparent"
        WidthRequest="48"
         HeightRequest="48"
  CornerRadius="24">
                <Button.ImageSource>
    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
    FontFamily="MaterialSymbolsOutlined"
    Color="{StaticResource Gray600}"
           Size="24"/>
      </Button.ImageSource>
           </Button>
       </Border>
  
        <!-- Send button / Loading indicator -->
     <Grid Grid.Column="2" WidthRequest="56" HeightRequest="56" VerticalOptions="End" Margin="4">
   <!-- Loading indicator background -->
     <Border IsVisible="{Binding IsBusy}"
         StrokeThickness="0"
      BackgroundColor="{StaticResource Primary}"
       StrokeShape="RoundRectangle 28"
             Opacity="0.9">
       <ActivityIndicator IsRunning="{Binding IsBusy}"
          Color="White"
  HeightRequest="28"
   WidthRequest="28"
     HorizontalOptions="Center"
     VerticalOptions="Center"/>
        </Border>
         
         <!-- Send button -->
   <Border IsVisible="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"
  StrokeThickness="0"
       BackgroundColor="{StaticResource Primary}"
        StrokeShape="RoundRectangle 28">
 <Border.Shadow>
          <Shadow Brush="{StaticResource Primary}"
            Offset="0,4"
     Radius="12"
     Opacity="0.4"/>
    </Border.Shadow>
          <Button Command="{Binding SendMessageCommand}"
      BackgroundColor="Transparent"
    WidthRequest="56"
      HeightRequest="56"
       Padding="0">
       <Button.ImageSource>
         <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Send}"
 FontFamily="MaterialSymbolsOutlined"
  Color="White"
  Size="24"/>
  </Button.ImageSource>
       </Button>
            </Border>
                </Grid>
 </Grid>
        </Border>

        <!-- Overlays placed last so they render on top of other content -->
        <Grid RowSpan="3" IsVisible="{Binding IsInitializing}" BackgroundColor="#AA000000" VisualElement.ZIndex="99" InputTransparent="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsInitializing}" Color="White" HeightRequest="48" WidthRequest="48"/>
                <Label Text="Inicjalizowanie asystenta..." TextColor="White" FontSize="16" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

  <Grid RowSpan="3" IsVisible="{Binding HasInitializationError}" BackgroundColor="#FF000000" VisualElement.ZIndex="100" InputTransparent="False">
   <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="24">
          <Border BackgroundColor="White" 
       StrokeThickness="0"
  StrokeShape="RoundRectangle 8" 
          WidthRequest="360" 
         Padding="16">
 <Border.Shadow>
     <Shadow Brush="{StaticResource Gray400Brush}" Offset="0,4" Radius="12" Opacity="0.3"/>
     </Border.Shadow>
<VerticalStackLayout Spacing="12">
<Label Text="Błąd inicjalizacji" FontSize="18" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>
        <Label Text="{Binding InitializationError}" TextColor="Black" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
        <Button Text="Spróbuj ponownie" Command="{Binding RetryInitializationCommand}" HorizontalOptions="Center"/>
       </VerticalStackLayout>
    </Border>
         </VerticalStackLayout>
  </Grid>

     </Grid>
</Grid>

    <!-- Bottom Sheet for history using UraniumUI - defined in page Attachments -->
    <uranium:UraniumContentPage.Attachments>
        <material:BottomSheetView x:Name="historyBottomSheet"
           IsPresented="{Binding IsHistorySheetOpen, Mode=TwoWay}"
             DisablePageWhenOpened="True"
 CloseOnTapOutside="True"
           HeightRequest="420"
           VerticalOptions="End">
     <material:BottomSheetView.Header>
         <Grid ColumnDefinitions="*,Auto" Padding="16,8,16,16">
         <Label Text="Historia rozmów" 
        FontSize="20" 
       FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
          VerticalOptions="Center"/>
            <Button Grid.Column="1"
    Command="{Binding CloseHistoryCommand}"
    BackgroundColor="Transparent"
               WidthRequest="40"
   HeightRequest="40">
     <Button.ImageSource>
   <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
       FontFamily="MaterialSymbolsOutlined"
  Color="{StaticResource Gray600}"
       Size="24"/>
         </Button.ImageSource>
  </Button>
     </Grid>
  </material:BottomSheetView.Header>

          <material:BottomSheetView.Body>
 <VerticalStackLayout Padding="16,0,16,16" Spacing="16">
         <!-- New Conversation Button -->
  <Border StrokeThickness="1"
              Stroke="{StaticResource Primary}"
           StrokeShape="RoundRectangle 12"
     Padding="16,12"
   BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}">
             <Border.GestureRecognizers>
   <TapGestureRecognizer Command="{Binding NewConversationCommand}"/>
 </Border.GestureRecognizers>
          <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
      <Image HeightRequest="24" WidthRequest="24">
      <Image.Source>
           <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add}"
         FontFamily="MaterialSymbolsOutlined"
       Color="#FFEB3B"
         Size="24"/>
                </Image.Source>
               </Image>
          <Label Text="Nowa rozmowa"
    FontSize="16"
           FontAttributes="Bold"
 TextColor="#FFEB3B"
  VerticalOptions="Center"/>
    </HorizontalStackLayout>
    </Border>

   <!-- Conversations List -->
        <CollectionView ItemsSource="{Binding Conversations}"
   SelectionMode="None"
      HeightRequest="350">
          <CollectionView.EmptyView>
       <VerticalStackLayout VerticalOptions="Center" 
     HorizontalOptions="Center" 
           Spacing="12" 
        Padding="20">
      <ActivityIndicator IsRunning="{Binding IsLoadingHistory}" 
            IsVisible="{Binding IsLoadingHistory}"
    HeightRequest="32" 
            WidthRequest="32"
            Color="{StaticResource Primary}"/>
 <Label IsVisible="{Binding IsLoadingHistory, Converter={toolkit:InvertedBoolConverter}}"
       Text="Brak zapisanych rozmów" 
       FontSize="16"
      TextColor="{StaticResource Gray400}"
 HorizontalOptions="Center"/>
            </VerticalStackLayout>
     </CollectionView.EmptyView>
           <CollectionView.ItemTemplate>
         <DataTemplate x:DataType="vm:ConversationHistoryItemViewModel">
    <SwipeView>
   <SwipeView.RightItems>
  <SwipeItems>
            <SwipeItem Text="Usuń"
       BackgroundColor="#EF5350"
            Command="{Binding BindingContext.DeleteConversationCommand, Source={x:Reference ChatBotPageRoot}}"
       CommandParameter="{Binding .}"/>
           </SwipeItems>
      </SwipeView.RightItems>
          <Border Margin="0,4"
           Padding="16,12"
 StrokeThickness="1"
         Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
        StrokeShape="RoundRectangle 12"
     BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}">
            <Border.GestureRecognizers>
            <TapGestureRecognizer 
         Command="{Binding BindingContext.LoadConversationCommand, Source={x:Reference ChatBotPageRoot}}"
           CommandParameter="{Binding .}"/>
    </Border.GestureRecognizers>
         <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <Label Text="{Binding Title}"
          FontSize="15"
        FontAttributes="Bold"
     LineBreakMode="TailTruncation"
  TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
         <Image Grid.Column="1" 
  Grid.RowSpan="2"
       HeightRequest="20" 
     WidthRequest="20"
       VerticalOptions="Center">
   <Image.Source>
        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Chevron_right}"
    FontFamily="MaterialSymbolsOutlined"
    Color="{StaticResource Gray400}"
       Size="20"/>
          </Image.Source>
  </Image>
           <Label Grid.Row="1"
  Text="{Binding FormattedDate}"
        FontSize="13"
  TextColor="{StaticResource Gray500}"/>
        </Grid>
         </Border>
              </SwipeView>
             </DataTemplate>
      </CollectionView.ItemTemplate>
       </CollectionView>
        </VerticalStackLayout>
        </material:BottomSheetView.Body>
        </material:BottomSheetView>
    </uranium:UraniumContentPage.Attachments>
</uranium:UraniumContentPage>
