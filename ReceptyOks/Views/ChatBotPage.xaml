<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
             x:Class="ReceptyOks.Views.ChatBotPage"
             x:Name="ChatBotPageRoot"
             x:DataType="vm:ChatBotViewModel"
             Title="ChatBotPage"
             xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:md="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
             xmlns:controls="clr-namespace:ReceptyOks.Controls"
             Shell.NavBarIsVisible="False"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BlackBrownPurpleGradient}}">

    <!-- Main chat content -->
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Collapsible header: title always visible, action buttons shown when expanded -->
        <uranium:ExpanderView Grid.Row="0"
                              IsExpanded="False"
                              Padding="10,4"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <uranium:ExpanderView.Shadow>
                <Shadow Brush="{StaticResource Gray400Brush}" Offset="0,3" Radius="8" Opacity="0.12"/>
            </uranium:ExpanderView.Shadow>

            <uranium:ExpanderView.Header>
                <HorizontalStackLayout VerticalOptions="Center" Spacing="10" Padding="0,4">
                    <!-- Avatar with border -->
                    <Border StrokeThickness="2"
                            Stroke="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 18"
                            HeightRequest="36"
                            WidthRequest="36"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                        <Image Source="chatbot.png"
                               HeightRequest="24"
                               WidthRequest="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="Asystent"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                        <HorizontalStackLayout Spacing="6">
                            <Border StrokeThickness="0"
                                    BackgroundColor="#4CAF50"
                                    StrokeShape="RoundRectangle 4"
                                    HeightRequest="8"
                                    WidthRequest="8"
                                    VerticalOptions="Center"/>
                            <Label Text="Gotowy do pomocy"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </uranium:ExpanderView.Header>

            <!-- Header Buttons -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Padding="0,4,0,6">
                <Button Text="Zapisz"
                        Command="{Binding SaveConversationCommand}"
                        Style="{StaticResource ChatActionButton}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Save}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="#2196F3"
                                         Size="18"/>
                    </Button.ImageSource>
                </Button>

                <Button Text="Historia"
                        Command="{Binding OpenHistoryCommand}"
                        Style="{StaticResource ChatActionButton}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.History}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                         Size="18"/>
                    </Button.ImageSource>
                </Button>

                <Button Text="Wyczyść"
                        Command="{Binding ClearConversationCommand}"
                        Style="{StaticResource ChatActionButtonDanger}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Delete_sweep}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="#E53935"
                                         Size="18"/>
                    </Button.ImageSource>
                </Button>
            </HorizontalStackLayout>
        </uranium:ExpanderView>

        <!-- Messages List -->
        <CollectionView Grid.Row="1"
                        x:Name="MessagesCollection"
                        ItemsSource="{Binding Messages}"
                        Margin="12,8"
                        MaximumWidthRequest="1400"
                        BackgroundColor="Transparent"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" 
                                     HorizontalOptions="Center" 
                                     Spacing="16" 
                                     Padding="40">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 40"
                            HeightRequest="80"
                            WidthRequest="80"
                            HorizontalOptions="Center">
                        <Image HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Chat}"
                                                 FontFamily="MaterialSymbolsOutlined"
                                                 Color="{StaticResource Primary}"
                                                 Size="40"/>
                            </Image.Source>
                        </Image>
                    </Border>
                    <Label Text="Rozpocznij rozmowę" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center"/>
                    <Label Text="Zapytaj mnie o przepisy, składniki lub poproś o sugestie" 
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Grid Padding="8,6">
                        <!-- User message - right aligned, up to ~90% of available width -->
                        <Grid IsVisible="{Binding IsUser}"
                              ColumnDefinitions="1*,10*">
                        <Border Grid.Column="1"
                                HorizontalOptions="End"
                                Padding="8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24,24,4,24"
                                BackgroundColor="{StaticResource Primary}">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Primary}"
                                        Offset="0,4"
                                        Radius="12"
                                        Opacity="0.3"/>
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="8">
                                <!-- Image attachment preview -->
                                <Border IsVisible="{Binding HasImageAttachment}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        HeightRequest="180"
                                        WidthRequest="240"
                                        BackgroundColor="Black">
                                    <Image Source="{Binding AttachmentPath}"
                                           Aspect="AspectFill"
                                           HeightRequest="180"
                                           WidthRequest="240"/>
                                </Border>

                                <!-- PDF attachment chip -->
                                <Border IsVisible="{Binding HasPdfAttachment}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="10,8"
                                        BackgroundColor="#22FFFFFF">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Image HeightRequest="20" WidthRequest="20" VerticalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Picture_as_pdf}"
                                                                 FontFamily="MaterialSymbolsOutlined"
                                                                 Color="White"
                                                                 Size="20"/>
                                            </Image.Source>
                                        </Image>
                                        <Label Text="{Binding AttachmentFileName}"
                                               TextColor="White"
                                               FontSize="13"
                                               VerticalOptions="Center"
                                               LineBreakMode="MiddleTruncation"
                                               MaximumWidthRequest="240"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Text document chip -->
                                <Border IsVisible="{Binding HasDocumentAttachment}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="10,8"
                                        BackgroundColor="#22FFFFFF">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Image HeightRequest="20" WidthRequest="20" VerticalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Description}"
                                                                 FontFamily="MaterialSymbolsOutlined"
                                                                 Color="White"
                                                                 Size="20"/>
                                            </Image.Source>
                                        </Image>
                                        <Label Text="{Binding AttachmentFileName}"
                                               TextColor="White"
                                               FontSize="13"
                                               VerticalOptions="Center"
                                               LineBreakMode="MiddleTruncation"
                                               MaximumWidthRequest="240"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <Label Text="{Binding Content}"
                                       IsVisible="{Binding Content, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}"
                                       TextColor="White"
                                       FontSize="13"
                                       LineHeight="1.4"
                                       Padding="6,2"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>
                        </Grid>

                        <!-- Assistant message - left aligned, up to ~90% of available width, avatar inside bubble -->
                        <Grid IsVisible="{Binding IsAssistant}"
                              ColumnDefinitions="10*,1*">
                            <!-- Message bubble -->
                            <Border HorizontalOptions="Start"
                                    Padding="14,10,14,14"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    StrokeShape="RoundRectangle 24,24,24,4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray400Brush}"
                                            Offset="0,3"
                                            Radius="12"
                                            Opacity="0.15"/>
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="6">
                                <!-- Avatar in the top-left corner of the bubble -->
                                <Image Source="chatbot.png"
                                       HeightRequest="24"
                                       WidthRequest="24"
                                       HorizontalOptions="Start"/>
                                <md:MarkdownView MarkdownText="{Binding Content}"
                                                 LinkCommand="{Binding BindingContext.OpenLinkCommand, Source={x:Reference ChatBotPageRoot}}"
                                                 TextFontSize="13"
                                                 LineHeightMultiplier="1.3"
                                                 TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                 H1Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                 H2Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                 H3Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                 H1FontSize="18"
                                                 H2FontSize="16"
                                                 H3FontSize="14"
                                                 HyperlinkColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"
                                                 CodeBlockBackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                                 CodeBlockBorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                 CodeBlockTextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                                                 BlockQuoteBackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                                 BlockQuoteBorderColor="{StaticResource Primary}"
                                                 BlockQuoteTextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                                 TableHeaderTextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                 TableHeaderBackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                 TableRowTextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                 TableRowBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                                                 LineColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                 EnableCodeBlockCopy="True"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Error message with icon -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                VerticalOptions="End"
                MaximumWidthRequest="1400"
                Margin="16,0,16,8"
                Padding="16,12"
                BackgroundColor="#FFEBEE"
                StrokeThickness="1"
                Stroke="#FFCDD2"
                StrokeShape="RoundRectangle 12">
            <Border.Shadow>
                <Shadow Brush="#EF5350" Offset="0,2" Radius="8" Opacity="0.2"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Image HeightRequest="20" WidthRequest="20" VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Error}"
                                         FontFamily="MaterialSymbolsOutlined"
                                         Color="#C62828"
                                         Size="20"/>
                    </Image.Source>
                </Image>
                <Label Grid.Column="1"
                       Text="{Binding ErrorMessage}"
                       TextColor="#C62828"
                       FontSize="14"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap"/>
            </Grid>
        </Border>

        <!-- Input Area -->
        <VerticalStackLayout Grid.Row="2" Spacing="0" MaximumWidthRequest="1400">
            <!-- Pending attachment preview bar -->
            <Border IsVisible="{Binding HasPendingAttachment}"
                    Margin="16,0,16,8"
                    Padding="10"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <!-- Thumbnail for image, icon for PDF -->
                    <Border Grid.Column="0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            WidthRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}">
                        <Grid>
                            <Image IsVisible="{Binding PendingAttachment.IsImage, FallbackValue=False}"
                                   Source="{Binding PendingAttachment.FilePath}"
                                   Aspect="AspectFill"
                                   HeightRequest="48"
                                   WidthRequest="48"/>
                            <Image IsVisible="{Binding PendingAttachment.IsPdf, FallbackValue=False}"
                                   HeightRequest="24"
                                   WidthRequest="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Picture_as_pdf}"
                                                     FontFamily="MaterialSymbolsOutlined"
                                                     Color="#EF5350"
                                                     Size="24"/>
                                </Image.Source>
                            </Image>
                            <Image IsVisible="{Binding PendingAttachment.IsTextDocument, FallbackValue=False}"
                                   HeightRequest="24"
                                   WidthRequest="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Description}"
                                                     FontFamily="MaterialSymbolsOutlined"
                                                     Color="#42A5F5"
                                                     Size="24"/>
                                </Image.Source>
                            </Image>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding PendingAttachment.OriginalFileName}"
                               FontSize="14"
                               FontAttributes="Bold"
                               LineBreakMode="MiddleTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                        <Label Text="{Binding PendingAttachment.MediaType}"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            Command="{Binding RemoveAttachmentCommand}"
                            BackgroundColor="Transparent"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"
                            AutomationProperties.Name="Usuń załącznik"
                            AutomationProperties.HelpText="Usuwa wybrany załącznik przed wysłaniem wiadomości">
                        <Button.ImageSource>
                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
                                             FontFamily="MaterialSymbolsOutlined"
                                             Color="{StaticResource Gray600}"
                                             Size="20"/>
                        </Button.ImageSource>
                    </Button>
                </Grid>
            </Border>

            <Border Margin="12,6,12,10"
                Padding="4"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                StrokeShape="RoundRectangle 25"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Gray400Brush}"
                        Offset="0,-3"
                        Radius="16"
                        Opacity="0.12"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4" MinimumHeightRequest="40">
                <!-- Attachment (paperclip) button -->
                <Border Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="End"
                        AutomationProperties.Name="Dodaj załącznik"
                        AutomationProperties.HelpText="Otwiera menu wyboru zdjęcia, PDF-a lub dokumentu">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowAttachmentOptionsCommand}"/>
                    </Border.GestureRecognizers>
                    <Image HeightRequest="20"
                           WidthRequest="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Attach_file}"
                                             FontFamily="MaterialSymbolsOutlined"
                                             Color="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                             Size="20"/>
                        </Image.Source>
                    </Image>
                </Border>

                <!-- Text input -->
                <controls:BorderlessEditor Grid.Column="1"
                        Text="{Binding UserInput}"
                        Placeholder="Napisz wiadomość..."
                        PlaceholderColor="{StaticResource Gray400}"
                        FontSize="14"
                        AutoSize="TextChanges"
                        MaximumHeightRequest="120"
                        VerticalOptions="Center"
                        Margin="4,0"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                
                <!-- Cancel button (visible when busy) -->
                <Border Grid.Column="2"
                        IsVisible="{Binding IsBusy}"
                        WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="End"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        StrokeShape="RoundRectangle 20">
                    <Button Command="{Binding CancelCommand}"
                            BackgroundColor="Transparent"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            CornerRadius="20">
                        <Button.ImageSource>
                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
                                             FontFamily="MaterialSymbolsOutlined"
                                             Color="{StaticResource Gray600}"
                                             Size="20"/>
                        </Button.ImageSource>
                    </Button>
                </Border>

                <!-- Send button / Loading indicator -->
                <Grid Grid.Column="3" WidthRequest="40" HeightRequest="40" VerticalOptions="End">
                    <!-- Loading indicator background -->
                    <Border IsVisible="{Binding IsBusy}"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 20"
                            Opacity="0.9">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           Color="White"
                                           HeightRequest="22"
                                           WidthRequest="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                    </Border>
        
                    <!-- Send button -->
                    <Border IsVisible="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 20">
                        <Button Command="{Binding SendMessageCommand}"
                                BackgroundColor="Transparent"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0">
                            <Button.ImageSource>
                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Send}"
                                                 FontFamily="MaterialSymbolsOutlined"
                                                 Color="White"
                                                 Size="24"/>
                            </Button.ImageSource>
                        </Button>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        </VerticalStackLayout>

        <!-- Overlays placed last so they render on top of other content -->
        <Grid RowSpan="3" IsVisible="{Binding IsInitializing}" BackgroundColor="#AA000000" InputTransparent="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsInitializing}" Color="White" HeightRequest="48" WidthRequest="48"/>
                <Label Text="Inicjalizowanie asystenta..." TextColor="White" FontSize="16" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <Grid RowSpan="3" IsVisible="{Binding HasInitializationError}" BackgroundColor="#FF000000" InputTransparent="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="24">
                <Border BackgroundColor="White" 
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8" 
                        WidthRequest="360" 
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Gray400Brush}" Offset="0,4" Radius="12" Opacity="0.3"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Błąd inicjalizacji" FontSize="18" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>
                        <Label Text="{Binding InitializationError}" TextColor="Black" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                        <Button Text="Spróbuj ponownie" Command="{Binding RetryInitializationCommand}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- History Panel Overlay -->
        <Grid Grid.RowSpan="3" 
              IsVisible="{Binding IsHistorySheetOpen}" 
              InputTransparent="False">
            <!-- Background overlay - tap to close -->
            <BoxView BackgroundColor="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseHistoryCommand}"/>
                </BoxView.GestureRecognizers>
            </BoxView>
            
            <!-- History Panel -->
            <Border VerticalOptions="End"
                    HeightRequest="450"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Gray400Brush}" Offset="0,-4" Radius="16" Opacity="0.3"/>
                </Border.Shadow>
        
                <Grid RowDefinitions="Auto,*" Padding="0">
                    <!-- Header -->
                    <Grid HeightRequest="56" ColumnDefinitions="*,Auto" Padding="20,16">
                        <Label Text="Historia rozmów"
                               FontSize="20" 
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                               VerticalOptions="Center"/>
                        <Border Grid.Column="1"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                StrokeShape="RoundRectangle 20"
                                Padding="0">
                            <Button Command="{Binding CloseHistoryCommand}"
                                    BackgroundColor="Transparent"
                                    WidthRequest="40"
                                    HeightRequest="40">
                                <Button.ImageSource>
                                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Close}"
                                                     FontFamily="MaterialSymbolsOutlined"
                                                     Color="{StaticResource Gray600}"
                                                     Size="24"/>
                                </Button.ImageSource>
                            </Button>
                        </Border>
                    </Grid>
      
                    <!-- Content -->
                    <ScrollView Grid.Row="1" Padding="16,0,16,16">
                        <VerticalStackLayout Spacing="16">
                            <!-- New Conversation Button -->
                            <Border StrokeThickness="1"
                                    Stroke="{StaticResource Primary}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16,12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NewConversationCommand}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                                    <Image HeightRequest="24" WidthRequest="24">
                                        <Image.Source>
                                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add}"
                                                             FontFamily="MaterialSymbolsOutlined"
                                                             Color="#FFEB3B"
                                                             Size="24"/>
                                        </Image.Source>
                                    </Image>
                                    <Label Text="Nowa rozmowa"
                                          FontSize="16"
                                          FontAttributes="Bold"
                                          TextColor="#FFEB3B"
                                          VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Conversations List -->
                            <CollectionView ItemsSource="{Binding Conversations}"
                                            SelectionMode="None"
                                            HeightRequest="320">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout VerticalOptions="Center" 
                                                         HorizontalOptions="Center" 
                                                         Spacing="12" 
                                                         Padding="20">
                                        <ActivityIndicator IsRunning="{Binding IsLoadingHistory}" 
                                                           IsVisible="{Binding IsLoadingHistory}"
                                                           HeightRequest="32" 
                                                           WidthRequest="32"
                                                           Color="{StaticResource Primary}"/>
                                        <Label IsVisible="{Binding IsLoadingHistory, Converter={toolkit:InvertedBoolConverter}}"
                                               Text="Brak zapisanych rozmów" 
                                               FontSize="16"
                                               TextColor="{StaticResource Gray400}"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConversationHistoryItemViewModel">
                                        <SwipeView>
                                            <SwipeView.RightItems>
                                                <SwipeItems>
                                                    <SwipeItem Text="Usuń"
                                                               BackgroundColor="#EF5350"
                                                               Command="{Binding BindingContext.DeleteConversationCommand, Source={x:Reference ChatBotPageRoot}}"
                                                               CommandParameter="{Binding .}"/>
                                                </SwipeItems>
                                            </SwipeView.RightItems>
                                            <Border Margin="0,4"
                                                    Padding="16,12"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer 
                                                        Command="{Binding BindingContext.LoadConversationCommand, Source={x:Reference ChatBotPageRoot}}"
                                                        CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                    <Label Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontAttributes="Bold"
                                                           LineBreakMode="TailTruncation"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                                    <Image Grid.Column="1" 
                                                           Grid.RowSpan="2"
                                                           HeightRequest="20" 
                                                           WidthRequest="20"
                                                           VerticalOptions="Center">
                                                        <Image.Source>
                                                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Chevron_right}"
                                                                             FontFamily="MaterialSymbolsOutlined"
                                                                             Color="{StaticResource Gray400}"
                                                                             Size="20"/>
                                                        </Image.Source>
                                                    </Image>
                                                    <Label Grid.Row="1"
                                                           Text="{Binding FormattedDate}"
                                                           FontSize="13"
                                                           TextColor="{StaticResource Gray500}"/>
                                                </Grid>
                                            </Border>
                                        </SwipeView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
