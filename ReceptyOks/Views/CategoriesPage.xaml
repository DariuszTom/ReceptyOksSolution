<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
             xmlns:data="clr-namespace:ReceptyOks.Data"
             x:Class="ReceptyOks.Views.CategoriesPage"
             x:DataType="vm:CategoriesViewModel"
             Title="Kategorie">

    <Grid RowDefinitions="*">
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCategoriesCommand}">
            <CollectionView ItemsSource="{Binding Categories}"
                            EmptyView="Brak kategorii. Dodaj pierwsz�!">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:CategoryLocal">
                        <Frame Margin="10,5" Padding="15" CornerRadius="10">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=ViewRecipesInCategoryCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="{StaticResource Primary}"
                                       CornerRadius="25"
                                       HeightRequest="50"
                                       WidthRequest="50"
                                       Padding="0">
                                    <Label Text="??" 
                                           FontSize="24" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center"/>
                                </Frame>
                                <VerticalStackLayout Grid.Column="1" Margin="15,0" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" 
                                           FontSize="16" 
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding Description}" 
                                           FontSize="12" 
                                           TextColor="Gray"
                                           IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}"/>
                                </VerticalStackLayout>
                                <ImageButton Grid.Column="2" 
                                             Source="edit.png"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=EditCategoryCommand}"
                                             CommandParameter="{Binding .}"
                                             HeightRequest="24" 
                                             WidthRequest="24"
                                             VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- FAB - Add button -->
        <Button Text="+"
                FontSize="24"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Command="{Binding AddCategoryCommand}"/>
    </Grid>
</ContentPage>
