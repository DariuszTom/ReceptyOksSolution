<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceptyOks.ViewModels"
             xmlns:data="clr-namespace:ReceptyOks.Data"
             xmlns:icons="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ReceptyOks.Views.CategoriesPage"
             x:DataType="vm:CategoriesViewModel"
             Shell.NavBarIsVisible="False"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BlackBrownPurpleGradient}}">

    <Grid RowDefinitions="Auto,*">

        <!-- Custom Header -->
        <Grid Grid.Row="0"
              Padding="20,16"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <Grid.Shadow>
                <Shadow Brush="{StaticResource Gray400Brush}" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Grid.Shadow>
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Kategorie"
                       Style="{StaticResource PageTitle}"
                       FontSize="24"/>
                <Label Text="Organizuj swoje przepisy"
                       Style="{StaticResource CaptionLabel}"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Categories Grid -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Categories}"
                        Margin="12,16,12,0"
                        BackgroundColor="Transparent">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12"/>
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="40">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 40"
                            HeightRequest="80"
                            WidthRequest="80"
                            HorizontalOptions="Center">
                        <Image HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Folder_off}"
                                                 FontFamily="MaterialSymbolsOutlined"
                                                 Color="{StaticResource Gray400}"
                                                 Size="40"/>
                            </Image.Source>
                        </Image>
                    </Border>
                    <Label Text="Brak kategorii"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center"/>
                    <Label Text="Utwórz kategorie, aby lepiej organizować swoje przepisy"
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                    <Button Text="Dodaj kategorię"
                            Command="{Binding AddCategoryCommand}"
                            Style="{StaticResource GradientAddButton}"
                            CornerRadius="24"
                            Padding="24,12"
                            HorizontalOptions="Center"
                            Margin="0,8,0,0">
                        <Button.ImageSource>
                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Add}"
                                             FontFamily="MaterialSymbolsOutlined"
                                             Color="White"
                                             Size="20"/>
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="data:CategoryLocal">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="0"
                            HeightRequest="160"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Gray400Brush}"
                                    Offset="0,4"
                                    Radius="12"
                                    Opacity="0.12"/>
                        </Border.Shadow>
                        <Grid RowDefinitions="*,Auto">
                            <!-- Category Icon Area -->
                            <Border Grid.Row="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20,20,0,0"
                                    BackgroundColor="{StaticResource Primary}">
                                <Grid>
                                    <!-- Custom category icon -->
                                    <Image Source="{Binding IconName}"
                                           HeightRequest="56"
                                           WidthRequest="56"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Aspect="AspectFit"
                                           IsVisible="{Binding IconName, Converter={StaticResource HasCategoryIconConverter}}"/>
                                    <!-- Default folder icon -->
                                    <Image HeightRequest="48" WidthRequest="48"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IconName, Converter={StaticResource IsNullConverter}}">
                                        <Image.Source>
                                            <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Folder}"
                                                             FontFamily="MaterialSymbolsOutlined"
                                                             Color="White"
                                                             Size="48"/>
                                        </Image.Source>
                                    </Image>
                                    <!-- Action buttons -->
                                    <HorizontalStackLayout HorizontalOptions="End"
                                                           VerticalOptions="Start"
                                                           Margin="8"
                                                           Spacing="6">
                                        <!-- Edit button -->
                                        <Border Padding="8"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16"
                                                BackgroundColor="#40FFFFFF">
                                            <Image HeightRequest="18" WidthRequest="18">
                                                <Image.Source>
                                                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Edit}"
                                                                     FontFamily="MaterialSymbolsOutlined"
                                                                     Color="White"
                                                                     Size="18"/>
                                                </Image.Source>
                                            </Image>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=EditCategoryCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                        </Border>
                                        <!-- Delete button -->
                                        <Border Padding="8"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16"
                                                BackgroundColor="#40FF0000">
                                            <Image HeightRequest="18" WidthRequest="18">
                                                <Image.Source>
                                                    <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Delete}"
                                                                     FontFamily="MaterialSymbolsOutlined"
                                                                     Color="White"
                                                                     Size="18"/>
                                                </Image.Source>
                                            </Image>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=DeleteCategoryCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Category Info -->
                            <VerticalStackLayout Grid.Row="1"
                                                 Spacing="2"
                                                 Padding="14,12"
                                                 BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                                <Label Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"/>
                                <Label Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}"/>
                            </VerticalStackLayout>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=ViewRecipesInCategoryCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- FAB - Add button -->
        <Button Grid.Row="1"
                WidthRequest="64"
                HeightRequest="64"
                CornerRadius="32"
                BackgroundColor="{StaticResource Primary}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20,20,20,24"
                Command="{Binding AddCategoryCommand}">
            <Button.Shadow>
                <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="16" Opacity="0.4"/>
            </Button.Shadow>
            <Button.ImageSource>
                <FontImageSource Glyph="{x:Static icons:MaterialOutlined.Create_new_folder}"
                                 FontFamily="MaterialSymbolsOutlined"
                                 Color="White"
                                 Size="28"/>
            </Button.ImageSource>
        </Button>
    </Grid>
</ContentPage>
